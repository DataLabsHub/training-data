+
+func (fs *fileStore) RegisterExpiryWorkUpdates(cb ExpiryWorkUpdateHandler, clock RuntimeClock) {
+	fs.mu.Lock()
+	fs.expiryState.Epoch++
+	fs.expiryState.Pass = 0
+	fs.expiryState.Storage = FileStorage
+	fs.expiryCB, fs.expiryNow = cb, clock
+	recovered := fs.recovered
+	state := fs.expiryState
+	if recovered > 0 {
+		state.Recovered = true
+		state.Processed = recovered
+		fs.expiryState = state
+		fs.recovered = 0
+	}
+	fs.mu.Unlock()
+	if cb != nil && recovered > 0 {
+		cb(state)
+	}
+}
+
+func (fs *fileStore) ExpiryWorkState() ExpiryWorkState {
+	fs.mu.RLock()
+	state := fs.expiryState
+	fs.mu.RUnlock()
+	return state
+}
