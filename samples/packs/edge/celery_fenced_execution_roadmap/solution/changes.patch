+class ExecutionSchedulePolicy:
+    """Deterministic deadline-aware catch-up policy for periodic work."""
+
+    def __init__(self, *, batch_limit=100, max_lateness=300.0,
+                 tenant_limits=None, clock=None):
+        if not isinstance(batch_limit, int) or batch_limit <= 0:
+            raise ValueError('batch_limit must be a positive integer')
+        if max_lateness < 0:
+            raise ValueError('max_lateness cannot be negative')
+        self.batch_limit = batch_limit
+        self.max_lateness = float(max_lateness)
+        self.tenant_limits = {
+            str(key): int(value)
+            for key, value in dict(tenant_limits or {}).items()
+        }
+        if any(value <= 0 for value in self.tenant_limits.values()):
+            raise ValueError('tenant schedule limits must be positive')
+        self.clock = clock
+
+    def eligible(self, item, *, now=None):
+        now = self._now() if now is None else float(now)
+        due_at = float(item.get('due_at', now))
+        deadline = item.get('deadline')
+        if deadline is not None and float(deadline) <= now:
+            return False
+        if now - due_at > self.max_lateness:
+            return False
+        cancellation = item.get('cancelled', False)
+        return not cancellation
+
+    def catch_up(self, items, cursor=None, *, schedule_revision=0, now=None):
+        cursor = cursor or ReplayCursor(schedule_revision=schedule_revision)
+        if not isinstance(cursor, ReplayCursor):
+            cursor = ReplayCursor.decode(cursor)
+        if schedule_revision < cursor.schedule_revision:
+            raise ValueError('schedule revision cannot move backwards')
+        now = self._now() if now is None else float(now)
+        events = []
+        for item in items:
+            item = dict(item)
+            if not self.eligible(item, now=now):
+                continue
+            events.append(item)
+        events.sort(key=lambda item: (
+            int(item['sequence']), float(item.get('due_at', now)),
+            str(item.get('name', '')),
+        ))
+        tenant_counts = {}
+        selected = []
+        for item in events:
+            tenant = str(item.get('tenant') or 'default')
+            limit = self.tenant_limits.get(tenant, self.batch_limit)
+            count = tenant_counts.get(tenant, 0)
+            if count >= limit:
+                continue
+            tenant_counts[tenant] = count + 1
+            selected.append(item)
+            if len(selected) >= self.batch_limit:
+                break
+        batch, advanced = replay_after(
+            selected, cursor, batch_limit=self.batch_limit,
+        )
+        return batch, advanced.advance(schedule_revision=schedule_revision)
+
+    def envelope_for(self, item, *, parent=None):
+        item = dict(item)
+        if item.get('execution_envelope') is not None:
+            envelope = ExecutionEnvelope.from_value(item['execution_envelope'])
+        else:
+            envelope = ExecutionEnvelope.create(
+                str(item['task']), item.get('args'), item.get('kwargs'),
+                tenant=item.get('tenant', ''),
+                idempotency_key=item.get('idempotency_key'),
+                deadline=item.get('deadline'),
+                retry_budget=item.get('retry_budget'),
+                cancellation_scope=item.get('cancellation_scope'),
+            )
+        if parent is not None:
+            parent = ExecutionEnvelope.from_value(parent)
+            envelope = parent.child(
+                item.get('name') or item.get('sequence'),
+                deadline=envelope.deadline,
+                retry_budget=envelope.retry_budget,
+                cancellation_scope=envelope.cancellation_scope,
+            )
+        return envelope
+
+    def _now(self):
+        if self.clock is not None:
+            return float(self.clock.wall_time())
+        return float(datetime.now().timestamp())
+
