+        if not name:
+            raise ValueError('execution participant name is required')
+        if not (hasattr(participant, 'freeze') or
+                hasattr(participant, 'snapshot')):
+            raise TypeError('execution participant must be snapshot capable')
+        with self._lock:
+            previous = self._participants.get(name)
+            if previous is not None and previous is not participant:
+                raise ValueError(f'execution participant {name!r} is registered')
+            self._participants[name] = participant
+            snapshot = self._snapshots.get(name)
+            if snapshot is not None and hasattr(participant, 'restore'):
+                participant.restore(snapshot)
+            return participant
+
+    def unregister(self, name, participant=None):
+        with self._lock:
+            current = self._participants.get(name)
+            if current is None:
+                return False
+            if participant is not None and participant is not current:
+                return False
+            del self._participants[name]
+            return True
+
+    def on_connect(self, connection_id=None):
+        """Start a new broker epoch and restore frozen participants."""
+        with self._lock:
+            self.epoch += 1
+            self.connected = True
+            if connection_id is not None:
+                self.connection_id = str(connection_id)
+            restored = []
+            for name, participant in sorted(self._participants.items()):
+                snapshot = self._snapshots.get(name)
+                if snapshot is not None and hasattr(participant, 'restore'):
+                    participant.restore(snapshot)
+                if hasattr(participant, 'thaw'):
+                    try:
+                        participant.thaw(epoch=self.epoch)
+                    except TypeError:
+                        participant.thaw()
