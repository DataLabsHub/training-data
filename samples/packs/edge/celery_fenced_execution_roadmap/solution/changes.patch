+            'generation': self.generation,
+            'admitted_at': self.admitted_at,
+            'epoch': self.epoch,
+        }
+
+
+class ExecutionAdmissionController:
+    """Bounded, fair and restorable resource admission state machine.
+
+    Capacity is tracked independently for each resource class.  Tenants use
+    deficit round robin, while priority only orders tickets belonging to the
+    same tenant.  This prevents a high-volume tenant from monopolizing the
+    worker and prevents priority from becoming an unbounded global bypass.
+    """
+
+    schema = 1
+
+    def __init__(self, capacities=None, *, quantum=1, max_queue_per_tenant=64,
+                 clock=None):
+        capacities = capacities or {'cpu': 1}
+        self.capacities = {
+            str(name): int(value) for name, value in capacities.items()
+        }
+        if not self.capacities or any(value <= 0
+                                      for value in self.capacities.values()):
+            raise ValueError('resource capacities must be positive')
+        self.quantum = int(quantum)
+        self.max_queue_per_tenant = int(max_queue_per_tenant)
+        if self.quantum <= 0 or self.max_queue_per_tenant <= 0:
+            raise ValueError('quantum and queue limit must be positive')
+        self.clock = clock or SystemClock()
+        self.epoch = 0
+        self.draining = False
+        self._next_ticket = 1
+        self._queues = defaultdict(deque)
+        self._tenant_order = deque()
+        self._deficit = defaultdict(int)
+        self._leases = {}
+        self._used = defaultdict(int)
+        self._generations = {}
+        self._lock = threading.RLock()
+
+    def enqueue(self, envelope, *, resource='cpu', cost=1, priority=0):
+        envelope = ensure_live(envelope, clock=self.clock)
+        resource = str(resource)
+        cost = int(cost)
+        priority = int(priority)
+        if resource not in self.capacities:
+            raise AdmissionRejected('unknown-resource', envelope.execution_id)
+        if cost <= 0 or cost > self.capacities[resource]:
+            raise AdmissionRejected('invalid-resource-cost', envelope.execution_id)
+        tenant = envelope.tenant or ''
+        with self._lock:
+            if self.draining:
+                raise AdmissionRejected('worker-draining', envelope.execution_id)
+            floor = self._generations.get(envelope.execution_id, -1)
+            if envelope.generation < floor:
+                raise AdmissionRejected('stale-generation', envelope.execution_id)
+            self._generations[envelope.execution_id] = envelope.generation
+            queue = self._queues[tenant]
+            if len(queue) >= self.max_queue_per_tenant:
+                raise AdmissionRejected('tenant-queue-full', envelope.execution_id)
+            for item in queue:
+                if (item.envelope.execution_id == envelope.execution_id and
+                        item.envelope.generation == envelope.generation):
+                    return item
+            ticket = AdmissionTicket(
+                self._next_ticket, envelope, resource, cost,
+                float(self.clock.wall_time()), priority,
+            )
+            self._next_ticket += 1
+            queue.append(ticket)
+            ordered = sorted(queue, key=lambda item: (-item.priority, item.ticket_id))
+            self._queues[tenant] = deque(ordered)
+            if tenant not in self._tenant_order:
+                self._tenant_order.append(tenant)
+            return ticket
+
+    def _eligible(self, ticket):
+        return (self._used[ticket.resource] + ticket.cost <=
+                self.capacities[ticket.resource])
+
+    def admit_next(self):
+        with self._lock:
+            if self.draining or not self._tenant_order:
+                return None
+            visits = len(self._tenant_order)
+            while visits:
+                visits -= 1
+                tenant = self._tenant_order[0]
+                self._tenant_order.rotate(-1)
+                queue = self._queues[tenant]
+                if not queue:
+                    self._tenant_order.remove(tenant)
+                    del self._queues[tenant]
+                    continue
+                self._deficit[tenant] += self.quantum
+                ticket = queue[0]
+                try:
+                    ensure_live(ticket.envelope, clock=self.clock)
+                except Exception:
+                    queue.popleft()
+                    continue
+                floor = self._generations.get(ticket.envelope.execution_id, -1)
+                if ticket.envelope.generation < floor:
+                    queue.popleft()
+                    continue
+                if ticket.cost > self._deficit[tenant] or not self._eligible(ticket):
+                    continue
+                queue.popleft()
+                self._deficit[tenant] -= ticket.cost
+                self._used[ticket.resource] += ticket.cost
+                lease = AdmissionLease(
+                    ticket.ticket_id, ticket.envelope.execution_id, tenant,
+                    ticket.resource, ticket.cost, ticket.envelope.generation,
+                    float(self.clock.wall_time()), self.epoch,
+                )
+                self._leases[ticket.ticket_id] = lease
+                if not queue:
+                    try:
+                        self._tenant_order.remove(tenant)
+                    except ValueError:
+                        pass
+                    del self._queues[tenant]
+                return lease
+            return None
+
+    def release(self, ticket_id, *, generation=None):
+        ticket_id = int(ticket_id)
+        with self._lock:
+            lease = self._leases.get(ticket_id)
+            if lease is None:
+                return False
+            if generation is not None and lease.generation != int(generation):
+                return False
+            del self._leases[ticket_id]
+            self._used[lease.resource] -= lease.cost
+            if self._used[lease.resource] < 0:
+                raise RuntimeError('admission resource accounting underflow')
+            return True
+
+    def fence(self, execution_id, generation):
+        execution_id = str(execution_id)
+        generation = int(generation)
+        with self._lock:
+            floor = self._generations.get(execution_id, -1)
+            if generation < floor:
+                return False
+            self._generations[execution_id] = generation
+            for tenant, queue in list(self._queues.items()):
+                self._queues[tenant] = deque(
+                    ticket for ticket in queue
+                    if not (ticket.envelope.execution_id == execution_id and
+                            ticket.envelope.generation < generation)
+                )
+            return generation > floor
+
+    def cancel(self, execution_id, *, generation=None):
+        execution_id = str(execution_id)
+        removed = []
+        with self._lock:
+            for tenant, queue in list(self._queues.items()):
+                retained = deque()
+                for ticket in queue:
+                    if (ticket.envelope.execution_id == execution_id and
+                            (generation is None or
+                             ticket.envelope.generation == int(generation))):
+                        removed.append(ticket.ticket_id)
+                    else:
+                        retained.append(ticket)
+                self._queues[tenant] = retained
+            for ticket_id, lease in list(self._leases.items()):
+                if (lease.execution_id == execution_id and
+                        (generation is None or lease.generation == int(generation))):
+                    self.release(ticket_id, generation=lease.generation)
+                    removed.append(ticket_id)
+        return tuple(sorted(removed))
+
+    def begin_drain(self):
+        with self._lock:
+            self.draining = True
+            return self.snapshot()
+
+    def resume(self, *, epoch=None):
+        with self._lock:
+            next_epoch = self.epoch + 1 if epoch is None else int(epoch)
+            if next_epoch <= self.epoch:
+                raise ValueError('admission epoch must advance')
+            self.epoch = next_epoch
+            self.draining = False
+            return self.epoch
+
+    def snapshot(self):
+        with self._lock:
+            return {
+                'schema': self.schema,
+                'config': {
+                    'capacities': dict(sorted(self.capacities.items())),
+                    'quantum': self.quantum,
+                    'max_queue_per_tenant': self.max_queue_per_tenant,
+                },
+                'epoch': self.epoch,
+                'draining': self.draining,
+                'next_ticket': self._next_ticket,
+                'tenant_order': list(self._tenant_order),
+                'deficit': dict(sorted(self._deficit.items())),
+                'generations': dict(sorted(self._generations.items())),
+                'queues': {
+                    tenant: [ticket.as_dict() for ticket in queue]
+                    for tenant, queue in sorted(self._queues.items())
+                },
+                'leases': [self._leases[key].as_dict()
+                           for key in sorted(self._leases)],
+            }
+
+    @classmethod
+    def restore(cls, snapshot, *, clock=None):
+        if not isinstance(snapshot, dict) or snapshot.get('schema') != cls.schema:
+            raise ValueError('unsupported admission snapshot')
+        controller = cls(clock=clock, **snapshot['config'])
+        controller.epoch = int(snapshot.get('epoch', 0))
+        controller.draining = bool(snapshot.get('draining'))
+        controller._next_ticket = int(snapshot.get('next_ticket', 1))
+        controller._tenant_order = deque(snapshot.get('tenant_order') or ())
+        controller._deficit.update({str(key): int(value) for key, value in
+                                    (snapshot.get('deficit') or {}).items()})
+        controller._generations.update({str(key): int(value) for key, value in
+                                        (snapshot.get('generations') or {}).items()})
+        for tenant, raw_queue in (snapshot.get('queues') or {}).items():
+            for raw in raw_queue:
+                controller._queues[tenant].append(AdmissionTicket(
+                    int(raw['ticket_id']),
+                    ExecutionEnvelope.from_value(raw['envelope']),
+                    str(raw['resource']), int(raw['cost']),
+                    float(raw['enqueued_at']), int(raw.get('priority', 0)),
+                ))
+        for raw in snapshot.get('leases') or ():
+            lease = AdmissionLease(
+                int(raw['ticket_id']), str(raw['execution_id']),
+                str(raw.get('tenant') or ''), str(raw['resource']),
+                int(raw['cost']), int(raw['generation']),
+                float(raw['admitted_at']), int(raw['epoch']),
+            )
+            controller._leases[lease.ticket_id] = lease
+            controller._used[lease.resource] += lease.cost
+        return controller
+
+    def info(self):
+        with self._lock:
+            return {
+                'epoch': self.epoch,
+                'draining': self.draining,
+                'capacity': dict(sorted(self.capacities.items())),
+                'used': {key: self._used[key] for key in sorted(self.capacities)},
+                'queued': sum(len(queue) for queue in self._queues.values()),
+                'active': len(self._leases),
+                'tenants': tuple(self._tenant_order),
+            }
+
+    def encode(self):
+        return canonical_json(self.snapshot()).encode('utf-8')
