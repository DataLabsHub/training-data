+        ttl = float(ttl)
+        if ttl <= 0:
+            raise ValueError('visibility ttl must be positive')
+        deadline = now + ttl if expires_at is None else float(expires_at)
+        with self._lock:
+            current = self._leases.get(delivery_tag)
+            if current is not None:
+                if generation < current['generation']:
+                    raise ValueError('stale visibility generation')
+                if (generation == current['generation'] and
+                        execution_id != current['execution_id']):
+                    raise ValueError('delivery tag changed execution identity')
+            record = {
