+    tombstone_until: Optional[float] = None
+    audit: tuple = ()
+
+    def as_dict(self):
+        return {
+            'execution_id': self.execution_id,
+            'state': self.state,
+            'value': _canonicalize(self.value),
+            'version': self.version,
+            'generation': self.generation,
+            'updated_at': self.updated_at,
+            'tombstone_until': self.tombstone_until,
+            'audit': [dict(item) for item in self.audit],
+        }
