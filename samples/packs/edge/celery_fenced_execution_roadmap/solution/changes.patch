+    def __init__(self, *, clock=None, renewal_ratio=0.5):
+        if not 0 < renewal_ratio < 1:
+            raise ValueError('renewal_ratio must be between zero and one')
+        self.clock = clock or time.time
+        self.renewal_ratio = float(renewal_ratio)
+        self._leases = {}
+        self._settled = set()
+        self._frozen = False
+        self._lock = threading.RLock()
+
+    def register(self, delivery_tag, *, execution_id, owner='', generation=0,
+                 ttl=60.0, expires_at=None):
