+                'execution_id': str(execution_id),
+                'owner': str(owner),
+                'generation': int(generation),
+                'ttl': ttl,
+                'registered_at': now,
+                'expires_at': deadline,
+                'renew_after': now + ttl * self.renewal_ratio,
+                'renewals': 0 if current is None else current['renewals'],
+            }
+            self._leases[delivery_tag] = record
+            self._settled.discard(delivery_tag)
+            return dict(record)
