+        with self._lock:
+            key = envelope.execution_id
+            existing = self._reserved.get(key) or self._active.get(key)
+            if existing is not None:
+                old = existing.execution_envelope
+                if old.generation >= envelope.generation:
+                    self._quarantined[key].append({
+                        'generation': envelope.generation,
+                        'reason': 'duplicate-or-stale-reservation',
+                    })
+                    return False
+            self._reserved[key] = request
+            return True
