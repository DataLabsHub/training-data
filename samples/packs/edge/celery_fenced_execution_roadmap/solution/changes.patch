@@ -0,0 +1,1843 @@
+"""Durable, generation-fenced task execution primitives.
+
+The module is intentionally transport and backend neutral.  Celery's existing
+application, canvas, worker, result, event, and scheduler modules adapt these
+objects to their public APIs, while Kombu and Billiard use the same snapshots
+for broker visibility and process-pool drain.  No object here owns a thread or
+network connection; state changes are deterministic and can be persisted by a
+real backend.
+"""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+import math
+import threading
+from collections import OrderedDict, defaultdict, deque
+from dataclasses import dataclass, field, replace
+from datetime import datetime, timezone
+from enum import Enum
+from typing import Any, Callable, Iterable, Iterator, Mapping, MutableMapping, Optional, Sequence
+
+from celery.local import SystemClock, get_clock_source
+
+
+SCHEMA_VERSION = 1
+TERMINAL_STATES = frozenset({'SUCCESS', 'FAILURE', 'REVOKED', 'REJECTED', 'TOMBSTONE'})
+
+
+class ExecutionError(Exception):
+    """Base class for deterministic execution-contract failures."""
+
+
+class EnvelopeValidationError(ExecutionError, ValueError):
+    """An execution envelope is malformed or uses an unsupported schema."""
+
+
+class ExecutionExpired(ExecutionError):
+    """An operation would start or continue after its absolute deadline."""
+
+
+class RetryBudgetExhausted(ExecutionError):
+    """No retry token remains for this execution."""
+
+
+class ClaimConflict(ExecutionError):
+    """A live execution claim is owned by another fenced worker."""
+
+    def __init__(self, execution_id, owner, generation):
+        self.execution_id = execution_id
+        self.owner = owner
+        self.generation = generation
+        super().__init__(
+            f'execution {execution_id!r} is claimed by {owner!r} '
+            f'at generation {generation}'
+        )
+
+
+class LeaseConflict(ExecutionError):
+    """A delivery lease operation failed its owner/generation fence."""
+
+
+class ResultConflict(ExecutionError):
+    """A compare-and-set result transition observed unexpected state."""
+
+    def __init__(self, execution_id, expected, actual_state, actual_version):
+        self.execution_id = execution_id
+        self.expected = expected
+        self.actual_state = actual_state
+        self.actual_version = actual_version
+        super().__init__(
+            f'result conflict for {execution_id!r}: expected {expected!r}; '
+            f'actual state={actual_state!r} version={actual_version}'
+        )
