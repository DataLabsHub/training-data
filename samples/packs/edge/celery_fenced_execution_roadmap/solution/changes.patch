+class VersionedResultStore:
+    """Reference backend implementing CAS, terminal fences, and tombstones."""
+
+    def __init__(self, records=None, *, clock=None, tombstone_ttl=86400.0):
+        self.clock = clock or SystemClock()
+        self.tombstone_ttl = float(tombstone_ttl)
+        self._records = {}
+        self._lock = threading.RLock()
+        for item in records or ():
+            item = dict(item)
+            item['audit'] = tuple(tuple(sorted(entry.items()))
+                                  for entry in item.get('audit') or ())
+            record = ResultRecord(**item)
+            self._records[record.execution_id] = record
+
+    def get(self, execution_id, *, include_expired_tombstone=False):
+        with self._lock:
+            record = self._records.get(str(execution_id))
+            if (record is not None and record.state == 'TOMBSTONE' and
+                    record.tombstone_until is not None and
+                    record.tombstone_until <= self.clock.wall_time() and
+                    not include_expired_tombstone):
+                return None
+            return record
+
+    def compare_and_set(self, execution_id, state, value=None, *,
+                        expected_state=None, expected_version=None,
+                        generation=0, repair=False, audit_reason=None):
+        execution_id = str(execution_id)
+        state = str(state).upper()
+        now = float(self.clock.wall_time())
+        generation = int(generation)
+        with self._lock:
+            current = self._records.get(execution_id)
+            actual_state = None if current is None else current.state
+            actual_version = 0 if current is None else current.version
+            expected = {'state': expected_state, 'version': expected_version}
+            if expected_state is not None and actual_state != expected_state:
+                raise ResultConflict(
+                    execution_id, expected, actual_state, actual_version
+                )
+            if expected_version is not None and actual_version != expected_version:
+                raise ResultConflict(
+                    execution_id, expected, actual_state, actual_version
+                )
+            if current is not None:
+                if generation < current.generation:
+                    raise ResultConflict(
+                        execution_id, {'generation_at_least': current.generation},
+                        actual_state, actual_version,
+                    )
+                if current.state in TERMINAL_STATES and not repair:
+                    if (current.state == state and current.value == value and
+                            generation == current.generation):
+                        return current, False
+                    raise ResultConflict(
+                        execution_id, {'non_terminal': True},
+                        actual_state, actual_version,
+                    )
+            audit = () if current is None else current.audit
+            if repair:
+                audit_entry = tuple(sorted({
+                    'at': now,
+                    'from_state': actual_state,
+                    'from_version': actual_version,
+                    'reason': str(audit_reason or 'explicit repair'),
+                }.items()))
+                audit = audit + (audit_entry,)
+            record = ResultRecord(
+                execution_id=execution_id, state=state,
+                value=_canonicalize(value), version=actual_version + 1,
+                generation=generation, updated_at=now,
+                tombstone_until=None, audit=audit,
+            )
+            self._records[execution_id] = record
+            return record, True
+
+    def store_legacy(self, execution_id, value, state, **kwargs):
+        """Compatibility transition used when no CAS arguments are supplied."""
+        current = self.get(execution_id, include_expired_tombstone=True)
+        return self.compare_and_set(
+            execution_id, state, value,
+            expected_version=None if current is None else current.version,
+            generation=kwargs.get('generation', 0),
+            repair=kwargs.get('repair', False),
+            audit_reason=kwargs.get('audit_reason'),
+        )[0]
+
+    def forget(self, execution_id, *, generation=0, ttl=None):
+        execution_id = str(execution_id)
+        now = float(self.clock.wall_time())
+        ttl = self.tombstone_ttl if ttl is None else float(ttl)
+        with self._lock:
+            current = self._records.get(execution_id)
+            if current is not None and current.state == 'TOMBSTONE':
+                if generation < current.generation:
+                    raise ResultConflict(
+                        execution_id, {'generation_at_least': current.generation},
+                        current.state, current.version,
+                    )
+                return current, False
+            version = 1 if current is None else current.version + 1
+            current_generation = 0 if current is None else current.generation
+            if generation < current_generation:
+                raise ResultConflict(
+                    execution_id, {'generation_at_least': current_generation},
+                    None if current is None else current.state,
+                    0 if current is None else current.version,
+                )
+            record = ResultRecord(
+                execution_id=execution_id, state='TOMBSTONE', value=None,
+                version=version, generation=generation, updated_at=now,
+                tombstone_until=now + ttl,
+                audit=() if current is None else current.audit,
+            )
+            self._records[execution_id] = record
+            return record, True
+
+    def snapshot(self):
+        with self._lock:
+            return tuple(self._records[key].as_dict() for key in sorted(self._records))
+
+    def encode(self):
+        return canonical_json({'schema': 1, 'records': self.snapshot()}).encode('utf-8')
+
+    @classmethod
+    def decode(cls, payload, *, clock=None, tombstone_ttl=86400.0):
+        if isinstance(payload, bytes):
+            payload = payload.decode('utf-8')
+        data = json.loads(payload)
+        if data.get('schema') != 1:
+            raise EnvelopeValidationError('unsupported result snapshot schema')
+        return cls(
+            data.get('records') or (), clock=clock,
+            tombstone_ttl=tombstone_ttl,
+        )
+
