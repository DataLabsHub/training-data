+@connect_on_app_finalize
+def add_execution_maintenance_tasks(app):
+    """Install internal tasks for durable execution lifecycle maintenance."""
+
+    @app.task(name='celery.execution_checkpoint', shared=False, lazy=False,
+              ignore_result=False)
+    def execution_checkpoint(identity='runtime', generation=0):
+        runtime = app.execution
+        snapshot = runtime.snapshot()
+        current = runtime.snapshots.load('runtime', identity)
+        expected = 0 if current is None else current.version
+        stored = runtime.snapshots.save(
+            'runtime', identity, snapshot,
+            generation=int(generation), expected_version=expected,
+        )
+        return {
+            'identity': identity,
+            'version': stored.version,
+            'generation': stored.generation,
+            'log_index': stored.log_index,
+        }
+
+    @app.task(name='celery.execution_compact', shared=False, lazy=False,
+              ignore_result=False)
+    def execution_compact(retain_transactions=128):
+        checkpoint, tail = app.execution.storage.compact(
+            retain_transactions=int(retain_transactions),
+        )
+        return {
+            'checkpoint': checkpoint,
+            'tail_records': len(tail),
+            'report': app.execution.storage.recovery_report(),
+        }
+
+    @app.task(name='celery.execution_release_expired', shared=False,
+              lazy=False, ignore_result=False)
+    def execution_release_expired():
+        runtime = app.execution
+        expired_leases = runtime.leases.expire()
+        expired_claims = []
+        now = runtime.clock.wall_time()
+        for claim in runtime.claims.snapshot():
+            if claim['expires_at'] <= now:
+                try:
+                    runtime.claims.release(
+                        claim['execution_id'], claim['owner'],
+                        claim['generation'],
+                    )
+                except Exception:
+                    continue
+                expired_claims.append(claim['execution_id'])
+        return {
+            'leases': len(expired_leases),
+            'claims': len(expired_claims),
+        }
+
+    return execution_checkpoint, execution_compact, execution_release_expired
+
