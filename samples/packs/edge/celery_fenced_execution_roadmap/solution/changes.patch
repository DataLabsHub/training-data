+class ExecutionConnectionState:
+    """Coordinate fenced-delivery state across broker reconnects.
+
+    Transports expose different connection lifecycles, so delivery lease
+    holders register here instead of attaching recovery callbacks to a
+    particular socket implementation.  The coordinator deliberately stores
+    only transport-neutral snapshots.  A reconnect advances an epoch before
+    participants are thawed, preventing callbacks from the old connection
+    from renewing leases in the new connection generation.
+    """
+
+    schema = 1
+
+    def __init__(self, connection_id=None):
+        self.connection_id = connection_id
