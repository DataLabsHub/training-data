+class EventJournal:
+    """Per-execution ordered journal with bounded out-of-order buffering."""
+
+    def __init__(self, *, reorder_window=8):
+        if not isinstance(reorder_window, int) or reorder_window < 0:
+            raise ValueError('reorder_window must be a non-negative integer')
+        self.reorder_window = reorder_window
+        self._cursor = defaultdict(int)
+        self._events = defaultdict(list)
+        self._buffer = defaultdict(dict)
+        self._event_ids = set()
+        self._gaps = defaultdict(list)
+        self._terminal = {}
+        self._lock = threading.RLock()
+
+    def append(self, execution_id, event_id, sequence, kind, *, timestamp,
+               generation=0, payload=None):
+        execution_id = str(execution_id)
+        event_id = str(event_id)
+        sequence = int(sequence)
+        if sequence <= 0:
+            raise ValueError('journal sequence must be positive')
+        event = JournalEvent(
+            execution_id=execution_id, event_id=event_id,
+            sequence=sequence, kind=str(kind), timestamp=float(timestamp),
+            generation=int(generation),
+            payload=tuple(sorted(dict(payload or {}).items())),
+        )
+        with self._lock:
+            identity = (execution_id, event_id)
+            if identity in self._event_ids:
+                return (), False
+            self._event_ids.add(identity)
+            cursor = self._cursor[execution_id]
+            if sequence <= cursor:
+                return (), False
+            self._buffer[execution_id][sequence] = event
+            emitted = self._drain(execution_id)
+            return emitted, bool(emitted)
+
+    def _drain(self, execution_id):
+        emitted = []
+        buffer = self._buffer[execution_id]
+        cursor = self._cursor[execution_id]
+        while cursor + 1 in buffer:
+            cursor += 1
+            event = buffer.pop(cursor)
+            self._events[execution_id].append(event)
+            emitted.append(event)
+            if event.kind.upper() in TERMINAL_STATES:
+                self._terminal[execution_id] = event.kind.upper()
+        if buffer:
+            smallest = min(buffer)
+            largest = max(buffer)
+            if largest - cursor > self.reorder_window and smallest > cursor + 1:
+                gap = JournalGap(execution_id, cursor + 1, smallest - 1)
+                self._gaps[execution_id].append(gap)
+                cursor = smallest - 1
+                while cursor + 1 in buffer:
+                    cursor += 1
+                    event = buffer.pop(cursor)
+                    self._events[execution_id].append(event)
+                    emitted.append(event)
+                    if event.kind.upper() in TERMINAL_STATES:
+                        self._terminal[execution_id] = event.kind.upper()
+        self._cursor[execution_id] = cursor
+        return tuple(emitted)
+
+    def events(self, execution_id, *, after=0):
+        with self._lock:
+            return tuple(event for event in self._events.get(str(execution_id), ())
+                         if event.sequence > after)
+
+    def cursor(self, execution_id):
+        with self._lock:
+            return self._cursor.get(str(execution_id), 0)
+
+    def gaps(self, execution_id):
+        with self._lock:
+            return tuple(self._gaps.get(str(execution_id), ()))
+
+    def terminal(self, execution_id):
+        with self._lock:
+            return self._terminal.get(str(execution_id))
+
+    def snapshot(self):
+        with self._lock:
+            execution_ids = sorted(
+                set(self._cursor) | set(self._events) | set(self._buffer)
+            )
+            return {
+                'schema': 1,
+                'reorder_window': self.reorder_window,
+                'executions': {
+                    execution_id: {
+                        'cursor': self._cursor[execution_id],
+                        'events': [event.as_dict()
+                                   for event in self._events[execution_id]],
+                        'buffer': [self._buffer[execution_id][seq].as_dict()
+                                   for seq in sorted(self._buffer[execution_id])],
+                        'gaps': [gap.as_dict()
+                                 for gap in self._gaps[execution_id]],
+                        'terminal': self._terminal.get(execution_id),
+                    }
+                    for execution_id in execution_ids
+                },
+            }
+
+    def encode(self):
+        return canonical_json(self.snapshot()).encode('utf-8')
+
+    @classmethod
+    def restore(cls, payload):
+        if isinstance(payload, bytes):
+            payload = payload.decode('utf-8')
+        data = json.loads(payload) if isinstance(payload, str) else dict(payload)
+        if data.get('schema') != 1:
+            raise EnvelopeValidationError('unsupported event journal schema')
+        journal = cls(reorder_window=data.get('reorder_window', 8))
+        for execution_id, snapshot in data.get('executions', {}).items():
+            journal._cursor[execution_id] = int(snapshot.get('cursor', 0))
+            for item in snapshot.get('events', ()):
+                item = dict(item)
+                item['payload'] = tuple(sorted(dict(item.get('payload') or {}).items()))
+                event = JournalEvent(**item)
+                journal._events[execution_id].append(event)
+                journal._event_ids.add((execution_id, event.event_id))
+            for item in snapshot.get('buffer', ()):
+                item = dict(item)
+                item['payload'] = tuple(sorted(dict(item.get('payload') or {}).items()))
+                event = JournalEvent(**item)
+                journal._buffer[execution_id][event.sequence] = event
+                journal._event_ids.add((execution_id, event.event_id))
+            journal._gaps[execution_id].extend(
+                JournalGap(**item) for item in snapshot.get('gaps', ())
+            )
+            if snapshot.get('terminal') is not None:
+                journal._terminal[execution_id] = snapshot['terminal']
+        return journal
+
+
+@dataclass(frozen=True)
+class ReplayCursor:
+    """Opaque monotonic cursor shared by event replay and beat catch-up."""
+
+    schedule_revision: int = 0
+    sequence: int = 0
+    schema: int = 1
+
+    def __post_init__(self):
+        if self.schema != 1:
+            raise CursorError(f'unsupported replay cursor schema {self.schema}')
+        if self.schedule_revision < 0 or self.sequence < 0:
+            raise CursorError('cursor values must be non-negative')
+
+    def encode(self):
+        raw = canonical_json({
+            'schema': self.schema,
+            'schedule_revision': self.schedule_revision,
+            'sequence': self.sequence,
+        }).encode('utf-8')
+        return base64.urlsafe_b64encode(raw).decode('ascii').rstrip('=')
+
+    @classmethod
+    def decode(cls, value):
+        if isinstance(value, cls):
+            return value
+        if isinstance(value, bytes):
+            value = value.decode('ascii')
+        if not isinstance(value, str) or not value:
+            raise CursorError('cursor must be non-empty text')
+        try:
+            padded = value + '=' * (-len(value) % 4)
+            data = json.loads(base64.urlsafe_b64decode(padded).decode('utf-8'))
+            return cls(**data)
+        except CursorError:
+            raise
+        except Exception as exc:
+            raise CursorError('invalid replay cursor') from exc
+
+    def advance(self, *, schedule_revision=None, sequence=None):
+        revision = self.schedule_revision if schedule_revision is None else int(schedule_revision)
+        new_sequence = self.sequence if sequence is None else int(sequence)
+        if revision < self.schedule_revision or new_sequence < self.sequence:
+            raise CursorError('replay cursor cannot move backwards')
+        return replace(self, schedule_revision=revision, sequence=new_sequence)
+
+
+def replay_after(events, cursor, *, batch_limit=None, deadline=None, clock=None):
+    """Return a deterministic replay batch and its advanced cursor."""
+    cursor = ReplayCursor.decode(cursor) if not isinstance(cursor, ReplayCursor) else cursor
+    if batch_limit is not None:
+        if not isinstance(batch_limit, int) or batch_limit <= 0:
+            raise ValueError('batch_limit must be positive')
+    if deadline is not None:
+        clock = clock or SystemClock()
+        if clock.wall_time() >= deadline:
+            return (), cursor
+    ordered = sorted(
+        (item for item in events if int(item['sequence']) > cursor.sequence),
+        key=lambda item: (int(item['sequence']), str(item.get('event_id', ''))),
+    )
+    if batch_limit is not None:
+        ordered = ordered[:batch_limit]
+    if not ordered:
+        return (), cursor
+    advanced = cursor.advance(sequence=int(ordered[-1]['sequence']))
+    return tuple(ordered), advanced
+
+
+@dataclass(frozen=True)
+class DrainSnapshot:
+    """Stable worker handoff document used by Celery and Billiard."""
+
+    worker_id: str
+    created_at: float
+    leases: tuple = ()
+    reservations: tuple = ()
+    cancellations: tuple = ()
+    pool_jobs: tuple = ()
+    generation: int = 0
+    schema: int = 1
+
+    def __post_init__(self):
+        if self.schema != 1:
+            raise DrainError(f'unsupported drain snapshot schema {self.schema}')
+        if not self.worker_id:
+            raise DrainError('worker_id is required')
+        if self.generation < 0:
+            raise DrainError('drain generation cannot be negative')
+        for name in ('leases', 'reservations', 'cancellations', 'pool_jobs'):
+            value = getattr(self, name)
+            normalized = tuple(
+                sorted((_canonicalize(item) for item in value),
+                       key=canonical_json)
+            )
+            object.__setattr__(self, name, normalized)
+
+    def as_dict(self):
+        return {
+            'schema': self.schema,
+            'worker_id': self.worker_id,
+            'created_at': self.created_at,
+            'generation': self.generation,
+            'leases': list(self.leases),
+            'reservations': list(self.reservations),
+            'cancellations': list(self.cancellations),
+            'pool_jobs': list(self.pool_jobs),
+        }
+
+    def encode(self):
+        return canonical_json(self.as_dict()).encode('utf-8')
+
+    @classmethod
+    def decode(cls, payload):
+        if isinstance(payload, bytes):
+            payload = payload.decode('utf-8')
+        try:
+            return cls(**json.loads(payload))
+        except DrainError:
+            raise
+        except Exception as exc:
+            raise DrainError('invalid drain snapshot') from exc
+
+    def restorable(self, *, now, minimum_generation=0, cancelled_scopes=()):
+        cancelled_scopes = set(cancelled_scopes)
+        active_leases = tuple(
+            lease for lease in self.leases
+            if float(lease.get('expires_at', 0)) > now and
+            int(lease.get('generation', 0)) >= minimum_generation
+        )
+        reservations = tuple(
+            item for item in self.reservations
+            if item.get('cancellation_scope') not in cancelled_scopes and
+            (item.get('deadline') is None or float(item['deadline']) > now) and
+            int(item.get('generation', 0)) >= minimum_generation
+        )
+        reservation_ids = {
+            item.get('execution_id') for item in reservations
+        }
+        jobs = tuple(
+            item for item in self.pool_jobs
+            if item.get('execution_id') in reservation_ids
+        )
+        return replace(
+            self, leases=active_leases, reservations=reservations,
+            pool_jobs=jobs,
+        )
+
+
+class DrainController:
+    """Idempotent worker drain gate and snapshot producer."""
+
+    def __init__(self, worker_id, *, clock=None):
+        self.worker_id = str(worker_id)
+        self.clock = clock or SystemClock()
+        self.accepting = True
+        self.generation = 0
+        self._last_snapshot = None
+        self._restored_ids = set()
+        self._lock = threading.RLock()
+
+    def begin(self):
+        with self._lock:
+            if not self.accepting:
+                return False
+            self.accepting = False
+            self.generation += 1
+            return True
+
+    def require_accepting(self):
+        with self._lock:
+            if not self.accepting:
+                raise DrainError(f'worker {self.worker_id!r} is draining')
+
+    def snapshot(self, *, leases=(), reservations=(), cancellations=(), pool_jobs=()):
+        with self._lock:
+            snapshot = DrainSnapshot(
+                worker_id=self.worker_id,
+                created_at=float(self.clock.wall_time()),
+                generation=self.generation,
+                leases=tuple(leases), reservations=tuple(reservations),
+                cancellations=tuple(cancellations), pool_jobs=tuple(pool_jobs),
+            )
+            if (self._last_snapshot is not None and
+                    self._last_snapshot.encode() == snapshot.encode()):
+                return self._last_snapshot
+            self._last_snapshot = snapshot
+            return snapshot
+
+    def restore(self, snapshot, *, minimum_generation=0, cancelled_scopes=()):
+        if not isinstance(snapshot, DrainSnapshot):
+            snapshot = DrainSnapshot.decode(snapshot)
+        filtered = snapshot.restorable(
+            now=float(self.clock.wall_time()),
+            minimum_generation=minimum_generation,
+            cancelled_scopes=cancelled_scopes,
+        )
+        with self._lock:
+            unique_jobs = []
+            for item in filtered.pool_jobs:
+                job_id = (item.get('execution_id'), item.get('job_id'))
+                if job_id not in self._restored_ids:
+                    self._restored_ids.add(job_id)
+                    unique_jobs.append(item)
+            return replace(filtered, pool_jobs=tuple(unique_jobs))
+
+
+class OrphanDecision(str, Enum):
+    NOT_ORPHAN = 'not_orphan'
+    ESCROW = 'escrow'
+    DROP = 'drop'
+    QUARANTINE = 'quarantine'
+
+
+@dataclass(frozen=True)
+class EscrowItem:
+    envelope: ExecutionEnvelope
+    tenant: str
+    enqueued_at: float
+    source_generation: int
+    reason: str
+
+    def as_dict(self):
+        return {
+            'envelope': self.envelope.as_dict(),
+            'tenant': self.tenant,
+            'enqueued_at': self.enqueued_at,
+            'source_generation': self.source_generation,
+            'reason': self.reason,
+        }
+
+
+class OrphanEscrow:
+    """Adaptive, fair recovery queue for multiply-confirmed orphaned tasks.
+
+    Classification requires independent claim, lease, journal, and process-pool
+    evidence.  Recoverable work is held in a bounded tenant queue.  Deficit
+    round-robin release and adaptive allowances avoid allowing a tenant with a
+    repeated crash loop to monopolize recovery capacity.
+    """
+
+    def __init__(self, *, clock=None, max_per_tenant=64, base_allowance=4,
+                 minimum_allowance=1, recovery_successes=3):
+        if max_per_tenant <= 0 or base_allowance <= 0:
+            raise ValueError('escrow capacities must be positive')
+        self.clock = clock or SystemClock()
+        self.max_per_tenant = int(max_per_tenant)
+        self.base_allowance = int(base_allowance)
+        self.minimum_allowance = int(minimum_allowance)
+        self.recovery_successes = int(recovery_successes)
+        self._queues = defaultdict(deque)
+        self._allowance = defaultdict(lambda: self.base_allowance)
+        self._credits = defaultdict(int)
+        self._orphan_streak = defaultdict(int)
+        self._success_streak = defaultdict(int)
+        self._order = deque()
+        self._quarantine = []
+        self._lock = threading.RLock()
+
+    def classify(self, envelope, *, claim_missing, lease_missing,
+                 journal_nonterminal, pool_missing, terminal_generation=None,
+                 cancelled=False):
+        envelope = ExecutionEnvelope.from_value(envelope)
+        now = float(self.clock.wall_time())
+        if terminal_generation is not None and envelope.generation <= terminal_generation:
+            return OrphanDecision.QUARANTINE
+        if cancelled:
+            return OrphanDecision.DROP
+        if envelope.deadline is not None and envelope.deadline <= now:
+            return OrphanDecision.DROP
+        if envelope.retry_budget is not None and envelope.retry_budget <= 0:
+            return OrphanDecision.DROP
+        evidence = (claim_missing, lease_missing, journal_nonterminal, pool_missing)
+        if all(evidence):
+            return OrphanDecision.ESCROW
+        return OrphanDecision.NOT_ORPHAN
+
+    def submit(self, envelope, *, claim_missing, lease_missing,
+               journal_nonterminal, pool_missing, terminal_generation=None,
+               cancelled=False, reason='orphan evidence converged'):
+        envelope = ExecutionEnvelope.from_value(envelope)
+        decision = self.classify(
+            envelope,
+            claim_missing=claim_missing, lease_missing=lease_missing,
+            journal_nonterminal=journal_nonterminal, pool_missing=pool_missing,
+            terminal_generation=terminal_generation, cancelled=cancelled,
+        )
+        with self._lock:
+            if decision == OrphanDecision.QUARANTINE:
+                self._quarantine.append({
+                    'envelope': envelope.as_dict(),
+                    'terminal_generation': terminal_generation,
+                    'reason': 'late pre-escrow generation',
+                })
+                return decision, False
+            if decision != OrphanDecision.ESCROW:
+                return decision, False
+            tenant = envelope.tenant or 'default'
+            queue = self._queues[tenant]
+            if any(item.envelope.execution_id == envelope.execution_id
+                   and item.source_generation == envelope.generation
+                   for item in queue):
+                return decision, False
+            if len(queue) >= self.max_per_tenant:
+                queue.popleft()
+            queue.append(EscrowItem(
+                envelope=envelope, tenant=tenant,
+                enqueued_at=float(self.clock.wall_time()),
+                source_generation=envelope.generation, reason=str(reason),
+            ))
+            if tenant not in self._order:
+                self._order.append(tenant)
+            self._orphan_streak[tenant] += 1
+            self._success_streak[tenant] = 0
+            if self._orphan_streak[tenant] > self.base_allowance:
+                self._allowance[tenant] = max(
+                    self.minimum_allowance,
+                    self._allowance[tenant] - 1,
+                )
+            return decision, True
+
+    def record_success(self, tenant):
+        tenant = str(tenant or 'default')
+        with self._lock:
+            self._success_streak[tenant] += 1
+            self._orphan_streak[tenant] = 0
+            if self._success_streak[tenant] >= self.recovery_successes:
+                self._allowance[tenant] = min(
+                    self.base_allowance, self._allowance[tenant] + 1
+                )
+                self._success_streak[tenant] = 0
+            return self._allowance[tenant]
+
+    def release(self, limit=1, *, cancellations=None):
+        if not isinstance(limit, int) or limit <= 0:
+            raise ValueError('release limit must be positive')
+        now = float(self.clock.wall_time())
+        released = []
+        with self._lock:
+            rotations_without_release = 0
+            while self._order and len(released) < limit:
+                tenant = self._order[0]
+                queue = self._queues[tenant]
+                self._credits[tenant] += self._allowance[tenant]
+                made_progress = False
+                while queue and self._credits[tenant] > 0 and len(released) < limit:
+                    item = queue[0]
+                    envelope = item.envelope
+                    cancelled = bool(
+                        cancellations is not None and envelope.cancellation_scope and
+                        cancellations.is_cancelled(envelope.cancellation_scope)
+                    )
+                    invalid = (
+                        cancelled or
+                        (envelope.deadline is not None and envelope.deadline <= now) or
+                        (envelope.retry_budget is not None and envelope.retry_budget <= 0)
+                    )
+                    queue.popleft()
+                    self._credits[tenant] -= 1
+                    made_progress = True
+                    if invalid:
+                        continue
+                    released_envelope = envelope.with_updates(
+                        generation=envelope.generation + 1,
+                        retry_budget=(None if envelope.retry_budget is None
+                                      else envelope.retry_budget - 1),
+                        extensions={
+                            **dict(envelope.extensions),
+                            'escrow_source_generation': envelope.generation,
+                            'escrow_released_at': now,
+                        },
+                    )
+                    released.append(released_envelope)
+                self._order.rotate(-1)
+                if not queue:
+                    self._order.remove(tenant)
+                    self._queues.pop(tenant, None)
+                    self._credits.pop(tenant, None)
+                if made_progress:
+                    rotations_without_release = 0
+                else:
+                    rotations_without_release += 1
+                    if rotations_without_release >= len(self._order or (1,)):
+                        break
+            return tuple(released)
+
+    def quarantine_late_result(self, execution_id, generation, active_generation,
+                               value=None):
+        if generation >= active_generation:
+            return False
+        with self._lock:
+            self._quarantine.append({
+                'execution_id': str(execution_id),
+                'generation': int(generation),
+                'active_generation': int(active_generation),
+                'value': _canonicalize(value),
+                'reason': 'late result fenced after escrow release',
+            })
+            return True
+
+    def snapshot(self):
+        with self._lock:
+            return {
+                'schema': 1,
+                'config': {
+                    'max_per_tenant': self.max_per_tenant,
+                    'base_allowance': self.base_allowance,
+                    'minimum_allowance': self.minimum_allowance,
+                    'recovery_successes': self.recovery_successes,
+                },
+                'order': list(self._order),
+                'queues': {
+                    tenant: [item.as_dict() for item in queue]
+                    for tenant, queue in sorted(self._queues.items())
+                },
+                'allowance': dict(sorted(self._allowance.items())),
+                'credits': dict(sorted(self._credits.items())),
+                'orphan_streak': dict(sorted(self._orphan_streak.items())),
+                'success_streak': dict(sorted(self._success_streak.items())),
+                'quarantine': list(self._quarantine),
+            }
+
+    def encode(self):
+        return canonical_json(self.snapshot()).encode('utf-8')
+
+    @classmethod
+    def restore(cls, payload, *, clock=None):
+        if isinstance(payload, bytes):
+            payload = payload.decode('utf-8')
+        data = json.loads(payload) if isinstance(payload, str) else dict(payload)
+        if data.get('schema') != 1:
+            raise EnvelopeValidationError('unsupported orphan escrow schema')
+        escrow = cls(clock=clock, **data.get('config', {}))
+        escrow._order = deque(data.get('order') or ())
+        for tenant, items in data.get('queues', {}).items():
+            for item in items:
+                item = dict(item)
+                item['envelope'] = ExecutionEnvelope.from_value(item['envelope'])
+                escrow._queues[tenant].append(EscrowItem(**item))
+        for name in ('allowance', 'credits', 'orphan_streak', 'success_streak'):
+            target = getattr(escrow, f'_{name}')
+            target.update({str(k): int(v) for k, v in data.get(name, {}).items()})
+        escrow._quarantine = list(data.get('quarantine') or ())
+        return escrow
+
+
+class ExecutionRuntime:
