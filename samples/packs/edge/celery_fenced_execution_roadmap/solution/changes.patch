+class ExecutionPublicationPolicy:
+    """Minimal Kombu-side validation for Celery execution headers."""
+
+    header = 'x-celery-execution'
+
+    def __init__(self, clock=None):
+        self.clock = clock or time.time
+
+    def prepare(self, headers):
+        prepared = dict(headers or {})
+        envelope = prepared.get(self.header)
+        if envelope is None:
+            return prepared
+        if not isinstance(envelope, dict):
+            raise TypeError('execution envelope header must be a mapping')
+        if envelope.get('schema', 1) != 1:
+            raise ValueError('unsupported execution envelope schema')
+        execution_id = envelope.get('execution_id')
+        if not isinstance(execution_id, str) or not execution_id:
+            raise ValueError('execution envelope requires execution_id')
+        for name in ('attempt', 'generation'):
+            value = envelope.get(name, 0)
+            if not isinstance(value, int) or isinstance(value, bool) or value < 0:
+                raise ValueError(f'execution {name} must be non-negative')
+        budget = envelope.get('retry_budget')
+        if budget is not None and (not isinstance(budget, int) or budget < 0):
+            raise ValueError('execution retry_budget must be non-negative')
+        deadline = envelope.get('deadline')
+        if deadline is not None and float(deadline) <= float(self.clock()):
+            raise ValueError('refusing to publish an expired execution')
+        prepared[self.header] = dict(envelope)
+        prepared.setdefault('x-kombu-execution-id', execution_id)
+        prepared.setdefault('x-kombu-execution-generation', envelope.get('generation', 0))
+        return prepared
+
+    def live(self, headers):
+        envelope = (headers or {}).get(self.header)
+        if envelope is None:
+            return True
+        deadline = envelope.get('deadline')
+        return deadline is None or float(deadline) > float(self.clock())
 
 
