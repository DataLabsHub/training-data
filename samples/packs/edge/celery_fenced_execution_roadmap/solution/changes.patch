+
+def _finite_number(value, name):
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        raise EnvelopeValidationError(f'{name} must be a finite number')
+    value = float(value)
+    if not math.isfinite(value):
+        raise EnvelopeValidationError(f'{name} must be a finite number')
+    return value
+
+
+def _canonicalize(value, path='$'):
+    """Return a JSON-safe canonical representation.
+
+    Tuple/list distinctions are intentionally erased for identity derivation.
+    Mapping keys are strings and sorted.  Bytes use an explicit tagged form so
+    they never collide with ordinary text.  Non-finite numbers are rejected
+    because JSON encoders disagree about their spelling.
+    """
+    if value is None or isinstance(value, (str, bool, int)):
+        return value
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise EnvelopeValidationError(f'non-finite number at {path}')
+        if value == 0:
+            return 0
+        return value
+    if isinstance(value, bytes):
+        return {'$bytes': base64.b64encode(value).decode('ascii')}
+    if isinstance(value, datetime):
+        if value.tzinfo is None:
+            value = value.replace(tzinfo=timezone.utc)
+        return {'$datetime': value.astimezone(timezone.utc).isoformat()}
+    if isinstance(value, Mapping):
+        normalized = {}
+        for key, item in value.items():
+            if not isinstance(key, str):
+                key = str(key)
+            normalized[key] = _canonicalize(item, f'{path}.{key}')
+        return {key: normalized[key] for key in sorted(normalized)}
+    if isinstance(value, (tuple, list)):
+        return [_canonicalize(item, f'{path}[{index}]')
+                for index, item in enumerate(value)]
+    if isinstance(value, (set, frozenset)):
+        items = [_canonicalize(item, f'{path}[]') for item in value]
+        return sorted(items, key=canonical_json)
+    if hasattr(value, 'as_dict') and callable(value.as_dict):
+        return _canonicalize(value.as_dict(), path)
+    raise EnvelopeValidationError(
+        f'unsupported value {type(value).__name__} at {path}'
+    )
+
+
+def canonical_json(value):
+    """Encode a value using stable JSON spelling and key ordering."""
+    return json.dumps(
+        _canonicalize(value), sort_keys=True, separators=(',', ':'),
+        ensure_ascii=False, allow_nan=False,
+    )
+
+
+def canonical_task_digest(task_name, args=None, kwargs=None, *, tenant='',
+                          idempotency_key=None):
+    """Derive a domain-separated execution identity for a task invocation."""
+    if not task_name or not isinstance(task_name, str):
+        raise EnvelopeValidationError('task_name must be a non-empty string')
+    document = {
+        'domain': 'celery-fenced-execution-v1',
+        'task': task_name,
+        'args': list(args or ()),
+        'kwargs': dict(kwargs or {}),
+        'tenant': str(tenant or ''),
+        'idempotency_key': None if idempotency_key is None else str(idempotency_key),
+    }
+    digest = hashlib.sha256(canonical_json(document).encode('utf-8')).hexdigest()
+    return f'exec-{digest}'
+
+
+def resolve_execution_id(task_name, args=None, kwargs=None, *, task_id=None,
+                         tenant='', idempotency_key=None):
+    """Preserve an explicit task id, otherwise derive a canonical identity."""
+    if task_id is not None:
+        task_id = str(task_id)
+        if not task_id:
+            raise EnvelopeValidationError('task_id cannot be empty')
+        return task_id
+    return canonical_task_digest(
+        task_name, args, kwargs, tenant=tenant,
+        idempotency_key=idempotency_key,
+    )
+
+
+@dataclass(frozen=True)
+class ExecutionEnvelope:
+    """Immutable execution metadata carried through the complete task path."""
+
+    execution_id: str
+    schema: int = SCHEMA_VERSION
+    attempt: int = 0
+    generation: int = 0
+    tenant: str = ''
+    deadline: Optional[float] = None
+    retry_budget: Optional[int] = None
+    cancellation_scope: Optional[str] = None
+    trace: tuple = ()
+    extensions: tuple = ()
+
+    def __post_init__(self):
+        if self.schema != SCHEMA_VERSION:
+            raise EnvelopeValidationError(
+                f'unsupported execution schema {self.schema}; expected {SCHEMA_VERSION}'
+            )
+        if not isinstance(self.execution_id, str) or not self.execution_id:
+            raise EnvelopeValidationError('execution_id must be non-empty text')
+        for name in ('attempt', 'generation'):
+            value = getattr(self, name)
+            if isinstance(value, bool) or not isinstance(value, int) or value < 0:
+                raise EnvelopeValidationError(f'{name} must be a non-negative integer')
+        if self.retry_budget is not None:
+            if (isinstance(self.retry_budget, bool) or
+                    not isinstance(self.retry_budget, int) or
+                    self.retry_budget < 0):
+                raise EnvelopeValidationError(
+                    'retry_budget must be a non-negative integer or null'
+                )
+        if self.deadline is not None:
+            object.__setattr__(self, 'deadline', _finite_number(self.deadline, 'deadline'))
+        object.__setattr__(self, 'tenant', str(self.tenant or ''))
+        if self.cancellation_scope is not None:
+            object.__setattr__(self, 'cancellation_scope', str(self.cancellation_scope))
+        object.__setattr__(self, 'trace', self._pairs(self.trace, 'trace'))
+        object.__setattr__(self, 'extensions', self._pairs(self.extensions, 'extensions'))
+
+    @staticmethod
+    def _pairs(value, name):
+        if isinstance(value, Mapping):
+            value = value.items()
+        try:
+            pairs = tuple((str(k), _canonicalize(v, f'$.{name}.{k}'))
+                          for k, v in value)
+        except Exception as exc:
+            if isinstance(exc, EnvelopeValidationError):
+                raise
+            raise EnvelopeValidationError(f'{name} must be a mapping') from exc
+        return tuple(sorted(pairs, key=lambda item: item[0]))
+
+    @classmethod
+    def create(cls, task_name, args=None, kwargs=None, *, task_id=None,
+               tenant='', idempotency_key=None, **fields):
+        execution_id = resolve_execution_id(
+            task_name, args, kwargs, task_id=task_id, tenant=tenant,
+            idempotency_key=idempotency_key,
+        )
+        return cls(execution_id=execution_id, tenant=tenant, **fields)
+
+    @classmethod
+    def from_value(cls, value):
+        if isinstance(value, cls):
+            return value
+        if isinstance(value, bytes):
+            value = value.decode('utf-8')
+        if isinstance(value, str):
+            try:
+                value = json.loads(value)
+            except (TypeError, ValueError) as exc:
+                raise EnvelopeValidationError('invalid envelope JSON') from exc
+        if not isinstance(value, Mapping):
+            raise EnvelopeValidationError('envelope must be bytes, text, or mapping')
+        known = {
+            'schema', 'execution_id', 'attempt', 'generation', 'tenant',
+            'deadline', 'retry_budget', 'cancellation_scope', 'trace',
+            'extensions',
+        }
+        extensions = dict(value.get('extensions') or {})
+        for key in value.keys() - known:
+            extensions[key] = value[key]
+        return cls(
+            schema=value.get('schema', SCHEMA_VERSION),
+            execution_id=value.get('execution_id'),
+            attempt=value.get('attempt', 0),
+            generation=value.get('generation', 0),
+            tenant=value.get('tenant', ''),
+            deadline=value.get('deadline'),
+            retry_budget=value.get('retry_budget'),
+            cancellation_scope=value.get('cancellation_scope'),
+            trace=value.get('trace') or {},
+            extensions=extensions,
+        )
+
+    def as_dict(self):
+        return {
+            'schema': self.schema,
+            'execution_id': self.execution_id,
+            'attempt': self.attempt,
+            'generation': self.generation,
+            'tenant': self.tenant,
+            'deadline': self.deadline,
+            'retry_budget': self.retry_budget,
+            'cancellation_scope': self.cancellation_scope,
+            'trace': dict(self.trace),
+            'extensions': dict(self.extensions),
+        }
+
+    def encode(self):
+        return canonical_json(self.as_dict()).encode('utf-8')
+
+    def with_updates(self, **updates):
+        if 'trace' in updates:
+            updates['trace'] = self._pairs(updates['trace'], 'trace')
+        if 'extensions' in updates:
+            updates['extensions'] = self._pairs(updates['extensions'], 'extensions')
+        return replace(self, **updates)
+
+    def child(self, label, *, generation=None, deadline=None,
+              retry_budget=None, cancellation_scope=None):
+        if not label:
+            raise EnvelopeValidationError('child label cannot be empty')
+        child_id = canonical_task_digest(
+            'celery.execution.child', [self.execution_id, str(label)], {},
+            tenant=self.tenant,
+        )
+        child_deadline = earliest_deadline(self.deadline, deadline)
+        child_budget = self.retry_budget
+        if retry_budget is not None:
+            child_budget = (retry_budget if child_budget is None
+                            else min(child_budget, retry_budget))
+        return replace(
+            self,
+            execution_id=child_id,
+            generation=self.generation if generation is None else generation,
+            deadline=child_deadline,
+            retry_budget=child_budget,
+            cancellation_scope=(self.cancellation_scope if cancellation_scope is None
+                                else cancellation_scope),
+            extensions=self._pairs(
+                {**dict(self.extensions), 'root_execution_id': self.execution_id,
+                 'child_label': str(label)},
+                'extensions',
+            ),
+        )
+
+
+def earliest_deadline(*values):
+    candidates = [_finite_number(v, 'deadline') for v in values if v is not None]
+    return min(candidates) if candidates else None
+
+
+def absolute_deadline(*, clock=None, countdown=None, expires=None,
+                      time_limit=None, parent=None):
+    """Normalize relative/absolute limits to the earliest epoch timestamp."""
+    clock = clock or SystemClock()
+    now = float(clock.wall_time())
+    candidates = []
+    if countdown is not None:
+        countdown = _finite_number(countdown, 'countdown')
+        candidates.append(now + countdown)
+    if time_limit is not None:
+        time_limit = _finite_number(time_limit, 'time_limit')
+        candidates.append(now + time_limit)
+    if expires is not None:
+        if isinstance(expires, datetime):
+            if expires.tzinfo is None:
+                expires = expires.replace(tzinfo=timezone.utc)
+            candidates.append(expires.timestamp())
+        elif isinstance(expires, str):
+            text = expires.replace('Z', '+00:00')
+            parsed = datetime.fromisoformat(text)
+            if parsed.tzinfo is None:
+                parsed = parsed.replace(tzinfo=timezone.utc)
+            candidates.append(parsed.timestamp())
+        else:
+            numeric = _finite_number(expires, 'expires')
+            candidates.append(numeric if numeric > 100000000 else now + numeric)
+    if parent is not None:
+        if isinstance(parent, ExecutionEnvelope):
+            parent = parent.deadline
+        if parent is not None:
+            candidates.append(_finite_number(parent, 'parent deadline'))
+    result = min(candidates) if candidates else None
+    if result is not None and result <= now:
+        raise ExecutionExpired(f'execution deadline {result} is not after {now}')
+    return result
+
+
+def ensure_live(envelope, *, clock=None):
+    envelope = ExecutionEnvelope.from_value(envelope)
+    clock = clock or SystemClock()
+    if envelope.deadline is not None and clock.wall_time() >= envelope.deadline:
+        raise ExecutionExpired(
+            f'execution {envelope.execution_id!r} expired at {envelope.deadline}'
+        )
+    return envelope
+
+
+@dataclass(frozen=True)
+class RetryBudget:
+    """Immutable shared retry allowance with deterministic backoff."""
+
+    remaining: Optional[int]
+    attempt: int = 0
+    base_delay: float = 1.0
+    maximum_delay: float = 600.0
+    jitter_ratio: float = 0.2
+
+    def __post_init__(self):
+        if self.remaining is not None:
+            if not isinstance(self.remaining, int) or self.remaining < 0:
+                raise EnvelopeValidationError('remaining retry budget must be non-negative')
+        if not isinstance(self.attempt, int) or self.attempt < 0:
+            raise EnvelopeValidationError('retry attempt must be non-negative')
+        if self.base_delay < 0 or self.maximum_delay < 0:
+            raise EnvelopeValidationError('retry delays cannot be negative')
+        if not 0 <= self.jitter_ratio <= 1:
+            raise EnvelopeValidationError('jitter_ratio must be between zero and one')
+
+    def consume(self, execution_id, *, now=None, deadline=None):
+        if self.remaining is not None and self.remaining <= 0:
+            raise RetryBudgetExhausted(f'retry budget for {execution_id!r} is exhausted')
+        exponent = min(self.attempt, 62)
+        nominal = min(self.maximum_delay, self.base_delay * (2 ** exponent))
+        seed = hashlib.sha256(
+            f'{execution_id}:{self.attempt}'.encode('utf-8')
+        ).digest()
+        unit = int.from_bytes(seed[:8], 'big') / float((1 << 64) - 1)
+        factor = 1 - self.jitter_ratio + (2 * self.jitter_ratio * unit)
+        delay = nominal * factor
+        if deadline is not None and now is not None and now + delay > deadline:
+            raise ExecutionExpired('retry would be scheduled beyond execution deadline')
+        return delay, replace(
+            self,
+            remaining=None if self.remaining is None else self.remaining - 1,
+            attempt=self.attempt + 1,
+        )
+
+
+@dataclass(frozen=True)
+class Claim:
+    execution_id: str
+    owner: str
+    generation: int
+    expires_at: float
+    acquired_at: float
+
+    def as_dict(self):
+        return {
+            'execution_id': self.execution_id,
+            'owner': self.owner,
+            'generation': self.generation,
+            'expires_at': self.expires_at,
+            'acquired_at': self.acquired_at,
+        }
+
+
+class ClaimStore:
+    """Thread-safe in-memory reference model for durable backend claims."""
+
+    def __init__(self, records=None, *, clock=None):
+        self.clock = clock or SystemClock()
+        self._claims = {}
+        self._lock = threading.RLock()
+        for item in records or ():
+            claim = item if isinstance(item, Claim) else Claim(**dict(item))
+            self._claims[claim.execution_id] = claim
+
+    def claim(self, execution_id, owner, *, generation, ttl):
+        if not execution_id or not owner:
+            raise ValueError('execution_id and owner are required')
+        if not isinstance(generation, int) or generation < 0:
+            raise ValueError('generation must be non-negative')
+        ttl = _finite_number(ttl, 'claim ttl')
+        if ttl <= 0:
+            raise ValueError('claim ttl must be positive')
+        now = float(self.clock.wall_time())
+        with self._lock:
+            current = self._claims.get(execution_id)
+            if current is not None:
+                if current.owner == owner and current.generation == generation:
+                    return current, False
+                if current.expires_at > now:
+                    raise ClaimConflict(
+                        execution_id, current.owner, current.generation
+                    )
+                if generation <= current.generation:
+                    raise ClaimConflict(
+                        execution_id, current.owner, current.generation
+                    )
+            claim = Claim(
+                execution_id=str(execution_id), owner=str(owner),
+                generation=generation, expires_at=now + ttl,
+                acquired_at=now,
+            )
+            self._claims[execution_id] = claim
+            return claim, True
+
+    def get(self, execution_id):
+        with self._lock:
+            return self._claims.get(execution_id)
+
+    def release(self, execution_id, owner, generation):
+        with self._lock:
+            current = self._claims.get(execution_id)
+            if current is None:
+                return False
+            if current.owner != owner or current.generation != generation:
+                raise ClaimConflict(execution_id, current.owner, current.generation)
+            del self._claims[execution_id]
+            return True
+
+    def snapshot(self):
+        with self._lock:
+            return tuple(self._claims[key].as_dict() for key in sorted(self._claims))
+
+    def encode(self):
+        return canonical_json({'schema': 1, 'claims': self.snapshot()}).encode('utf-8')
+
+    @classmethod
+    def decode(cls, payload, *, clock=None):
+        if isinstance(payload, bytes):
+            payload = payload.decode('utf-8')
+        data = json.loads(payload)
+        if data.get('schema') != 1:
+            raise EnvelopeValidationError('unsupported claim snapshot schema')
+        return cls(data.get('claims') or (), clock=clock)
+
+
+class LeaseStatus(str, Enum):
+    OPEN = 'open'
+    CLOSED = 'closed'
+    EXPIRED = 'expired'
+
+
+@dataclass(frozen=True)
+class DeliveryLease:
+    execution_id: str
+    delivery_tag: str
+    owner: str
+    generation: int
+    opened_at: float
+    expires_at: float
+    status: LeaseStatus = LeaseStatus.OPEN
+
+    def as_dict(self):
+        return {
+            'execution_id': self.execution_id,
+            'delivery_tag': self.delivery_tag,
+            'owner': self.owner,
+            'generation': self.generation,
+            'opened_at': self.opened_at,
+            'expires_at': self.expires_at,
+            'status': self.status.value,
+        }
+
+
+class LeaseRegistry:
+    """Delivery-tag registry enforcing owner and generation fencing."""
+
+    def __init__(self, *, clock=None):
+        self.clock = clock or SystemClock()
+        self._leases = {}
+        self._by_execution = {}
+        self._lock = threading.RLock()
+
+    def open(self, execution_id, delivery_tag, owner, generation, ttl):
+        now = float(self.clock.wall_time())
+        ttl = _finite_number(ttl, 'lease ttl')
+        if ttl <= 0:
+            raise ValueError('lease ttl must be positive')
+        delivery_tag = str(delivery_tag)
+        with self._lock:
+            existing_tag = self._by_execution.get(execution_id)
+            existing = self._leases.get(existing_tag)
+            if existing is not None and existing.status == LeaseStatus.OPEN:
+                if (existing.delivery_tag == delivery_tag and
+                        existing.owner == owner and
+                        existing.generation == generation):
+                    return existing, False
+                if existing.expires_at > now and generation <= existing.generation:
+                    raise LeaseConflict(
+                        f'active generation {existing.generation} fences {generation}'
+                    )
+            lease = DeliveryLease(
+                execution_id=str(execution_id), delivery_tag=delivery_tag,
+                owner=str(owner), generation=int(generation), opened_at=now,
+                expires_at=now + ttl,
+            )
+            self._leases[delivery_tag] = lease
+            self._by_execution[execution_id] = delivery_tag
+            return lease, True
+
+    def renew(self, delivery_tag, owner, generation, ttl):
+        now = float(self.clock.wall_time())
+        ttl = _finite_number(ttl, 'lease ttl')
+        if ttl <= 0:
+            raise ValueError('lease ttl must be positive')
+        delivery_tag = str(delivery_tag)
+        with self._lock:
+            lease = self._leases.get(delivery_tag)
+            if lease is None or lease.status != LeaseStatus.OPEN:
+                raise LeaseConflict(f'lease {delivery_tag!r} is not open')
+            if lease.owner != owner or lease.generation != generation:
+                raise LeaseConflict('lease owner or generation is stale')
+            if lease.expires_at <= now:
+                expired = replace(lease, status=LeaseStatus.EXPIRED)
+                self._leases[delivery_tag] = expired
+                raise LeaseConflict(f'lease {delivery_tag!r} has expired')
+            renewed = replace(lease, expires_at=now + ttl)
+            self._leases[delivery_tag] = renewed
+            return renewed
+
+    def close(self, delivery_tag, owner=None, generation=None):
+        delivery_tag = str(delivery_tag)
+        with self._lock:
+            lease = self._leases.get(delivery_tag)
+            if lease is None:
+                return False
+            if lease.status == LeaseStatus.CLOSED:
+                return False
+            if owner is not None and lease.owner != owner:
+                raise LeaseConflict('lease owner is stale')
+            if generation is not None and lease.generation != generation:
+                raise LeaseConflict('lease generation is stale')
+            self._leases[delivery_tag] = replace(lease, status=LeaseStatus.CLOSED)
+            self._by_execution.pop(lease.execution_id, None)
+            return True
+
+    def active(self, *, now=None):
+        now = float(self.clock.wall_time() if now is None else now)
+        with self._lock:
+            result = []
+            for tag, lease in list(self._leases.items()):
+                if lease.status == LeaseStatus.OPEN and lease.expires_at <= now:
+                    lease = replace(lease, status=LeaseStatus.EXPIRED)
+                    self._leases[tag] = lease
+                    self._by_execution.pop(lease.execution_id, None)
+                if lease.status == LeaseStatus.OPEN:
+                    result.append(lease)
+            return tuple(sorted(result, key=lambda item: item.delivery_tag))
+
+    def snapshot(self):
+        with self._lock:
+            return tuple(self._leases[key].as_dict() for key in sorted(self._leases))
+
+
+class DeliveryDecision(str, Enum):
+    ACCEPT = 'accept'
+    DUPLICATE = 'duplicate'
+    STALE = 'stale'
+    FUTURE = 'future'
+    EXPIRED = 'expired'
+    CANCELLED = 'cancelled'
+
+
+class DeliveryFence:
+    """Classify a delivery against claim and terminal-state evidence."""
+
+    def __init__(self, claims, results=None, cancellations=None, *, clock=None):
+        self.claims = claims
+        self.results = results
+        self.cancellations = cancellations
+        self.clock = clock or SystemClock()
+
+    def classify(self, envelope):
+        envelope = ExecutionEnvelope.from_value(envelope)
+        if envelope.deadline is not None and self.clock.wall_time() >= envelope.deadline:
+            return DeliveryDecision.EXPIRED
+        if (self.cancellations is not None and envelope.cancellation_scope and
+                self.cancellations.is_cancelled(envelope.cancellation_scope)):
+            return DeliveryDecision.CANCELLED
+        if self.results is not None:
+            record = self.results.get(envelope.execution_id)
+            if record is not None and record.state in TERMINAL_STATES:
+                if envelope.generation <= record.generation:
+                    return DeliveryDecision.DUPLICATE
+        claim = self.claims.get(envelope.execution_id)
+        if claim is None:
+            return DeliveryDecision.FUTURE if envelope.generation > 0 else DeliveryDecision.ACCEPT
+        if envelope.generation < claim.generation:
+            return DeliveryDecision.STALE
+        if envelope.generation > claim.generation:
+            return DeliveryDecision.FUTURE
+        return DeliveryDecision.ACCEPT
+
+
+@dataclass(frozen=True)
+class Cancellation:
+    scope_id: str
+    parent_id: Optional[str]
+    cancelled_at: Optional[float] = None
+    reason: Optional[str] = None
+
+    @property
+    def cancelled(self):
+        return self.cancelled_at is not None
+
+    def as_dict(self):
+        return {
+            'scope_id': self.scope_id,
+            'parent_id': self.parent_id,
+            'cancelled_at': self.cancelled_at,
+            'reason': self.reason,
+        }
+
+
+class CancellationRegistry:
+    """Hierarchical cancellation scopes with first-writer-wins reasons."""
+
+    def __init__(self, *, clock=None):
+        self.clock = clock or SystemClock()
+        self._scopes = {}
+        self._children = defaultdict(set)
+        self._lock = threading.RLock()
+
+    def create(self, scope_id, parent_id=None):
+        scope_id = str(scope_id)
+        parent_id = None if parent_id is None else str(parent_id)
+        with self._lock:
+            current = self._scopes.get(scope_id)
+            if current is not None:
+                if current.parent_id != parent_id:
+                    raise ValueError('scope already exists with another parent')
+                return current, False
+            inherited = None
+            if parent_id is not None:
+                parent = self._scopes.get(parent_id)
+                if parent is None:
+                    raise KeyError(f'unknown parent cancellation scope {parent_id!r}')
+                self._children[parent_id].add(scope_id)
+                if parent.cancelled:
+                    inherited = (parent.cancelled_at, parent.reason)
+            scope = Cancellation(
+                scope_id=scope_id, parent_id=parent_id,
+                cancelled_at=None if inherited is None else inherited[0],
+                reason=None if inherited is None else inherited[1],
+            )
+            self._scopes[scope_id] = scope
+            return scope, True
+
+    def cancel(self, scope_id, reason='cancelled'):
+        scope_id = str(scope_id)
+        with self._lock:
+            if scope_id not in self._scopes:
+                raise KeyError(scope_id)
+            root = self._scopes[scope_id]
+            if root.cancelled:
+                return root, False
+            when = float(self.clock.wall_time())
+            queue = deque([scope_id])
+            while queue:
+                current_id = queue.popleft()
+                current = self._scopes[current_id]
+                if not current.cancelled:
+                    self._scopes[current_id] = replace(
+                        current, cancelled_at=when, reason=str(reason)
+                    )
+                queue.extend(sorted(self._children.get(current_id, ())))
+            return self._scopes[scope_id], True
+
+    def is_cancelled(self, scope_id):
+        with self._lock:
+            scope = self._scopes.get(str(scope_id))
+            return bool(scope and scope.cancelled)
+
+    def get(self, scope_id):
+        with self._lock:
+            return self._scopes.get(str(scope_id))
+
+    def snapshot(self):
+        with self._lock:
+            return tuple(self._scopes[key].as_dict() for key in sorted(self._scopes))
+
+    @classmethod
+    def restore(cls, records, *, clock=None):
+        registry = cls(clock=clock)
+        pending = {item['scope_id']: dict(item) for item in records}
+        while pending:
+            progressed = False
+            for scope_id, item in list(pending.items()):
+                parent_id = item.get('parent_id')
+                if parent_id is None or parent_id in registry._scopes:
+                    scope = Cancellation(**item)
+                    registry._scopes[scope_id] = scope
+                    if parent_id is not None:
+                        registry._children[parent_id].add(scope_id)
+                    del pending[scope_id]
+                    progressed = True
+            if not progressed:
+                raise EnvelopeValidationError('cancellation snapshot contains a cycle')
+        return registry
+
+
+def propagate_envelope(parent, *, label, deadline=None, retry_budget=None,
+                       cancellation_scope=None):
+    """Create a canvas child without widening parent resource limits."""
+    parent = ExecutionEnvelope.from_value(parent)
+    return parent.child(
+        label, deadline=deadline, retry_budget=retry_budget,
+        cancellation_scope=cancellation_scope,
+    )
