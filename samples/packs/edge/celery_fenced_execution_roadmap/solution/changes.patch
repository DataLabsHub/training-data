+"""Crash-consistent storage and recovery for fenced execution state.
+
+The default implementation is deliberately filesystem free: production
+backends can persist its canonical records in Redis, SQL, or object storage,
+while workers and tests use the deterministic in-memory adapter.  Mutations
+are represented as an append-only write-ahead log and become visible only
+after a commit marker.  Recovery ignores incomplete transactions and rejects
+hash-chain corruption instead of guessing which generation should win.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import threading
+from collections import defaultdict
+from dataclasses import dataclass
+from typing import Any, Iterable, Mapping
+
+from .execution import (
+    EnvelopeValidationError,
+    ExecutionEnvelope,
+    canonical_json,
+)
+
+
+ZERO_DIGEST = '0' * 64
+
+
+class StorageError(RuntimeError):
+    """Base class for execution storage failures."""
+
+
+class StorageConflict(StorageError):
+    """A transaction precondition did not match durable state."""
+
+
+class CorruptExecutionLog(StorageError):
+    """A WAL segment is truncated, reordered, or hash-chain corrupt."""
+
+
+class IncompleteTransaction(StorageError):
+    """A caller attempted to expose an uncommitted transaction."""
+
+
+def _digest(value):
+    return hashlib.sha256(canonical_json(value).encode('utf-8')).hexdigest()
+
+
+@dataclass(frozen=True)
+class LogRecord:
+    index: int
+    transaction_id: str
+    operation: str
+    key: str
+    value: Any
+    expected_version: int | None
+    generation: int
+    previous_digest: str
+    digest: str
+
+    @classmethod
+    def build(cls, index, transaction_id, operation, key, value,
+              expected_version, generation, previous_digest):
+        body = {
+            'index': int(index),
+            'transaction_id': str(transaction_id),
+            'operation': str(operation),
+            'key': str(key),
+            'value': value,
+            'expected_version': expected_version,
+            'generation': int(generation),
+            'previous_digest': str(previous_digest),
+        }
+        return cls(digest=_digest(body), **body)
+
+    @classmethod
+    def from_value(cls, value):
+        if isinstance(value, cls):
+            return value
+        value = dict(value)
+        record = cls(
+            index=int(value['index']),
+            transaction_id=str(value['transaction_id']),
+            operation=str(value['operation']),
+            key=str(value.get('key') or ''),
+            value=value.get('value'),
+            expected_version=value.get('expected_version'),
+            generation=int(value.get('generation', 0)),
+            previous_digest=str(value['previous_digest']),
+            digest=str(value['digest']),
+        )
+        if record.expected_version is not None:
+            object.__setattr__(record, 'expected_version',
+                               int(record.expected_version))
+        record.validate()
+        return record
+
+    def body(self):
+        return {
+            'index': self.index,
+            'transaction_id': self.transaction_id,
+            'operation': self.operation,
+            'key': self.key,
+            'value': self.value,
+            'expected_version': self.expected_version,
+            'generation': self.generation,
+            'previous_digest': self.previous_digest,
+        }
+
+    def as_dict(self):
+        return {**self.body(), 'digest': self.digest}
+
+    def validate(self):
+        if self.index < 0:
+            raise CorruptExecutionLog('negative WAL record index')
+        if not self.transaction_id:
+            raise CorruptExecutionLog('empty WAL transaction id')
+        if self.operation not in {'put', 'delete', 'commit', 'abort'}:
+            raise CorruptExecutionLog(f'unknown WAL operation {self.operation!r}')
+        if self.operation in {'put', 'delete'} and not self.key:
+            raise CorruptExecutionLog('mutation record has no key')
+        if self.expected_version is not None and self.expected_version < 0:
+            raise CorruptExecutionLog('negative expected version')
+        if self.generation < 0:
+            raise CorruptExecutionLog('negative execution generation')
+        if _digest(self.body()) != self.digest:
+            raise CorruptExecutionLog(f'WAL record {self.index} digest mismatch')
+        return self
+
+
+@dataclass(frozen=True)
+class StoredValue:
+    key: str
+    value: Any
+    version: int
+    generation: int
+    transaction_id: str
+    log_index: int
+    deleted: bool = False
+
+    def as_dict(self):
+        return {
+            'key': self.key,
+            'value': self.value,
+            'version': self.version,
+            'generation': self.generation,
+            'transaction_id': self.transaction_id,
+            'log_index': self.log_index,
+            'deleted': self.deleted,
+        }
+
+
+class ExecutionTransaction:
+    """Single-use mutation builder owned by a DurableExecutionStore."""
+
+    def __init__(self, store, transaction_id, generation):
+        self.store = store
+        self.transaction_id = str(transaction_id)
+        self.generation = int(generation)
+        if not self.transaction_id or self.generation < 0:
+            raise ValueError('invalid transaction identity')
+        self.operations = []
+        self.closed = False
+
+    def _open(self):
+        if self.closed:
+            raise IncompleteTransaction('transaction is already closed')
+
+    def put(self, key, value, *, expected_version=None):
+        self._open()
+        if not key:
+            raise ValueError('storage key is required')
+        if expected_version is not None:
+            expected_version = int(expected_version)
+            if expected_version < 0:
+                raise ValueError('expected version cannot be negative')
+        self.operations.append(('put', str(key), value, expected_version))
+        return self
+
+    def delete(self, key, *, expected_version=None):
+        self._open()
+        if not key:
+            raise ValueError('storage key is required')
+        if expected_version is not None:
+            expected_version = int(expected_version)
+            if expected_version < 0:
+                raise ValueError('expected version cannot be negative')
+        self.operations.append(('delete', str(key), None, expected_version))
+        return self
+
+    def commit(self):
+        self._open()
+        self.closed = True
+        return self.store._commit(self)
+
+    def abort(self):
+        self._open()
+        self.closed = True
+        return self.store._abort(self)
+
+    def __enter__(self):
+        self._open()
+        return self
+
+    def __exit__(self, exc_type, exc, traceback):
+        if self.closed:
+            return False
+        if exc_type is not None:
+            self.abort()
+            return False
+        self.commit()
+        return False
+
+
+class DurableExecutionStore:
+    """Hash-chained transactional reference store for execution state."""
+
+    schema = 1
+
+    def __init__(self, records: Iterable[Mapping] = ()):
+        self._records = []
+        self._values = {}
+        self._transactions = {}
+        self._generation_floor = defaultdict(int)
+        self._last_digest = ZERO_DIGEST
+        self._lock = threading.RLock()
+        if records:
+            self.recover(records)
+
+    @property
+    def last_index(self):
+        with self._lock:
+            return len(self._records) - 1
+
+    @property
+    def last_digest(self):
+        with self._lock:
+            return self._last_digest
+
+    def begin(self, transaction_id, *, generation=0):
+        transaction_id = str(transaction_id)
+        with self._lock:
+            state = self._transactions.get(transaction_id)
+            if state == 'committed':
+                raise StorageConflict(f'transaction {transaction_id!r} committed')
+            if state == 'aborted':
+                raise StorageConflict(f'transaction {transaction_id!r} aborted')
+            if state == 'open':
+                raise StorageConflict(f'transaction {transaction_id!r} is open')
+            self._transactions[transaction_id] = 'open'
+        return ExecutionTransaction(self, transaction_id, generation)
+
+    def _record(self, transaction_id, operation, key='', value=None,
+                expected_version=None, generation=0):
+        record = LogRecord.build(
+            len(self._records), transaction_id, operation, key, value,
+            expected_version, generation, self._last_digest,
+        )
+        self._records.append(record)
+        self._last_digest = record.digest
+        return record
+
+    def _validate_operations(self, transaction):
+        shadow = {}
+        for operation, key, value, expected in transaction.operations:
+            current = shadow.get(key, self._values.get(key))
+            version = 0 if current is None else current.version
+            generation = -1 if current is None else current.generation
+            if expected is not None and expected != version:
+                raise StorageConflict(
+                    f'{key!r} expected version {expected}, observed {version}'
+                )
+            if transaction.generation < generation:
+                raise StorageConflict(
+                    f'{key!r} generation {transaction.generation} is stale; '
+                    f'observed {generation}'
+                )
+            shadow[key] = StoredValue(
+                key=key, value=value, version=version + 1,
+                generation=transaction.generation,
+                transaction_id=transaction.transaction_id,
+                log_index=-1, deleted=operation == 'delete',
+            )
+        return shadow
+
+    def _commit(self, transaction):
+        with self._lock:
+            if self._transactions.get(transaction.transaction_id) != 'open':
+                raise StorageConflict('transaction is not open')
+            try:
+                shadow = self._validate_operations(transaction)
+            except Exception:
+                self._record(
+                    transaction.transaction_id, 'abort',
+                    generation=transaction.generation,
+                )
+                self._transactions[transaction.transaction_id] = 'aborted'
+                raise
+            mutation_records = []
+            for operation, key, value, expected in transaction.operations:
+                mutation_records.append(self._record(
+                    transaction.transaction_id, operation, key, value,
+                    expected, transaction.generation,
+                ))
+            commit = self._record(
+                transaction.transaction_id, 'commit',
+                value={'mutations': len(mutation_records)},
+                generation=transaction.generation,
+            )
+            for key, pending in shadow.items():
+                matching = next(
+                    record for record in reversed(mutation_records)
+                    if record.key == key
+                )
+                self._values[key] = StoredValue(
+                    key=key, value=pending.value, version=pending.version,
+                    generation=pending.generation,
+                    transaction_id=pending.transaction_id,
+                    log_index=matching.index, deleted=pending.deleted,
+                )
+                self._generation_floor[key] = max(
+                    self._generation_floor[key], transaction.generation,
+                )
+            self._transactions[transaction.transaction_id] = 'committed'
+            return {
+                'transaction_id': transaction.transaction_id,
+                'commit_index': commit.index,
+                'mutations': tuple(record.as_dict()
+                                   for record in mutation_records),
+            }
+
+    def _abort(self, transaction):
+        with self._lock:
+            if self._transactions.get(transaction.transaction_id) != 'open':
+                raise StorageConflict('transaction is not open')
+            record = self._record(
+                transaction.transaction_id, 'abort',
+                generation=transaction.generation,
+            )
+            self._transactions[transaction.transaction_id] = 'aborted'
+            return record.as_dict()
+
+    def get(self, key, *, include_deleted=False):
+        with self._lock:
+            value = self._values.get(str(key))
+            if value is None or (value.deleted and not include_deleted):
+                return None
+            return value
+
+    def require(self, key, *, include_deleted=False):
+        value = self.get(key, include_deleted=include_deleted)
+        if value is None:
+            raise KeyError(key)
+        return value
+
+    def compare_and_put(self, key, value, *, transaction_id,
+                        expected_version, generation):
+        transaction = self.begin(transaction_id, generation=generation)
+        transaction.put(key, value, expected_version=expected_version)
+        transaction.commit()
+        return self.require(key)
+
+    def delete(self, key, *, transaction_id, expected_version=None,
+               generation=0):
+        transaction = self.begin(transaction_id, generation=generation)
+        transaction.delete(key, expected_version=expected_version)
+        transaction.commit()
+        return self.require(key, include_deleted=True)
+
+    def put_envelope(self, envelope, *, transaction_id=None,
+                     expected_version=None):
+        envelope = ExecutionEnvelope.from_value(envelope)
+        transaction_id = transaction_id or (
+            f'envelope:{envelope.execution_id}:{envelope.generation}'
+        )
+        return self.compare_and_put(
+            f'envelope/{envelope.execution_id}', envelope.as_dict(),
+            transaction_id=transaction_id,
+            expected_version=(0 if expected_version is None else expected_version),
+            generation=envelope.generation,
+        )
+
+    def get_envelope(self, execution_id):
+        value = self.get(f'envelope/{execution_id}')
+        return None if value is None else ExecutionEnvelope.from_value(value.value)
+
+    def scan(self, prefix='', *, include_deleted=False):
+        prefix = str(prefix)
+        with self._lock:
+            return tuple(
+                self._values[key] for key in sorted(self._values)
+                if key.startswith(prefix) and
+                (include_deleted or not self._values[key].deleted)
+            )
+
+    def transaction_state(self, transaction_id):
+        with self._lock:
+            return self._transactions.get(str(transaction_id))
+
+    def export_log(self, *, start=0, stop=None):
+        start = int(start)
+        if start < 0:
+            raise ValueError('start cannot be negative')
+        with self._lock:
+            records = self._records[start:stop]
+            return tuple(record.as_dict() for record in records)
+
+    @staticmethod
+    def validate_chain(records, *, previous_digest=ZERO_DIGEST,
+                       start_index=0):
+        normalized = []
+        expected_index = int(start_index)
+        digest = str(previous_digest)
+        for raw in records:
+            record = LogRecord.from_value(raw)
+            if record.index != expected_index:
+                raise CorruptExecutionLog(
+                    f'expected WAL index {expected_index}, got {record.index}'
+                )
+            if record.previous_digest != digest:
+                raise CorruptExecutionLog(
+                    f'WAL record {record.index} breaks hash chain'
+                )
+            normalized.append(record)
+            expected_index += 1
+            digest = record.digest
+        return tuple(normalized)
+
+    def recover(self, records):
+        """Replay complete transactions and ignore a trailing partial one."""
+        normalized = self.validate_chain(records)
+        with self._lock:
+            self._records = list(normalized)
+            self._last_digest = (
+                normalized[-1].digest if normalized else ZERO_DIGEST
+            )
+            self._values = {}
+            self._transactions = {}
+            pending = defaultdict(list)
+            for record in normalized:
+                if record.operation in {'put', 'delete'}:
+                    pending[record.transaction_id].append(record)
+                    self._transactions[record.transaction_id] = 'open'
+                    continue
+                if record.operation == 'abort':
+                    pending.pop(record.transaction_id, None)
+                    self._transactions[record.transaction_id] = 'aborted'
+                    continue
+                operations = pending.pop(record.transaction_id, [])
+                self._apply_recovered(record.transaction_id, operations)
+                self._transactions[record.transaction_id] = 'committed'
+            for transaction_id in pending:
+                self._transactions[transaction_id] = 'incomplete'
+            return self.recovery_report()
+
+    def _apply_recovered(self, transaction_id, operations):
+        for record in operations:
+            current = self._values.get(record.key)
+            version = 0 if current is None else current.version
+            if (record.expected_version is not None and
+                    record.expected_version != version):
+                raise CorruptExecutionLog(
+                    f'recovered precondition failed for {record.key!r}'
+                )
+            if current is not None and record.generation < current.generation:
+                raise CorruptExecutionLog(
+                    f'recovered stale generation for {record.key!r}'
+                )
+            self._values[record.key] = StoredValue(
+                key=record.key, value=record.value, version=version + 1,
+                generation=record.generation,
+                transaction_id=transaction_id, log_index=record.index,
+                deleted=record.operation == 'delete',
+            )
+
+    def checkpoint(self):
+        with self._lock:
+            return {
+                'schema': self.schema,
+                'last_index': self.last_index,
+                'last_digest': self.last_digest,
+                'values': [self._values[key].as_dict()
+                           for key in sorted(self._values)],
+                'transactions': dict(sorted(self._transactions.items())),
+            }
+
+    @classmethod
+    def from_checkpoint(cls, checkpoint, records=()):
+        if not isinstance(checkpoint, Mapping) or checkpoint.get('schema') != cls.schema:
+            raise EnvelopeValidationError('unsupported execution checkpoint')
+        store = cls()
+        with store._lock:
+            for raw in checkpoint.get('values') or ():
+                raw = dict(raw)
+                value = StoredValue(
+                    key=str(raw['key']), value=raw.get('value'),
+                    version=int(raw['version']),
+                    generation=int(raw['generation']),
+                    transaction_id=str(raw['transaction_id']),
+                    log_index=int(raw['log_index']),
+                    deleted=bool(raw.get('deleted')),
+                )
+                store._values[value.key] = value
+            store._transactions = dict(checkpoint.get('transactions') or {})
+            store._last_digest = str(checkpoint.get('last_digest', ZERO_DIGEST))
+        if records:
+            tail = store.validate_chain(
+                records, previous_digest=store._last_digest,
+                start_index=int(checkpoint.get('last_index', -1)) + 1,
+            )
+            # Checkpoint-tail replay uses a synthetic full log solely to retain
+            # the same commit semantics; state entries remain authoritative.
+            pending = defaultdict(list)
+            for record in tail:
+                store._records.append(record)
+                store._last_digest = record.digest
+                if record.operation in {'put', 'delete'}:
+                    pending[record.transaction_id].append(record)
+                elif record.operation == 'commit':
+                    store._apply_recovered(
+                        record.transaction_id,
+                        pending.pop(record.transaction_id, []),
+                    )
+                    store._transactions[record.transaction_id] = 'committed'
+                else:
+                    pending.pop(record.transaction_id, None)
+                    store._transactions[record.transaction_id] = 'aborted'
+        return store
+
+    def compact(self, *, retain_transactions=128):
+        """Return a checkpoint and a bounded tail without mutating state."""
+        retain_transactions = int(retain_transactions)
+        if retain_transactions < 0:
+            raise ValueError('retain_transactions cannot be negative')
+        with self._lock:
+            terminal = []
+            seen = set()
+            for record in reversed(self._records):
+                if record.transaction_id not in seen and record.operation in {
+                        'commit', 'abort'}:
+                    seen.add(record.transaction_id)
+                    terminal.append(record.index)
+                    if len(seen) >= retain_transactions:
+                        break
+            start = min(terminal) if terminal else len(self._records)
+            return self.checkpoint(), self.export_log(start=start)
+
+    def recovery_report(self):
+        with self._lock:
+            states = defaultdict(int)
+            for state in self._transactions.values():
+                states[state] += 1
+            return {
+                'records': len(self._records),
+                'values': sum(not item.deleted for item in self._values.values()),
+                'tombstones': sum(item.deleted for item in self._values.values()),
+                'transactions': dict(sorted(states.items())),
+                'last_digest': self._last_digest,
+            }
+
+    def encode_log(self):
+        return canonical_json({
+            'schema': self.schema,
+            'records': self.export_log(),
+        }).encode('utf-8')
+
+    @classmethod
+    def decode_log(cls, payload):
+        if isinstance(payload, bytes):
+            payload = payload.decode('utf-8')
+        data = json.loads(payload)
+        if data.get('schema') != cls.schema:
+            raise EnvelopeValidationError('unsupported durable log schema')
+        return cls(data.get('records') or ())
+
+
+class ExecutionSnapshotCatalog:
+    """Generation-fenced catalog for worker and scheduler snapshots."""
+
+    def __init__(self, store=None):
+        self.store = store or DurableExecutionStore()
+
+    @staticmethod
+    def _key(kind, identity):
+        if kind not in {'worker', 'scheduler', 'events', 'escrow', 'runtime'}:
+            raise ValueError(f'unsupported snapshot kind {kind!r}')
+        if not identity:
+            raise ValueError('snapshot identity is required')
+        return f'snapshot/{kind}/{identity}'
+
+    def save(self, kind, identity, snapshot, *, generation,
+             expected_version=None, transaction_id=None):
+        key = self._key(kind, identity)
+        current = self.store.get(key)
+        if expected_version is None:
+            expected_version = 0 if current is None else current.version
+        transaction_id = transaction_id or (
+            f'{key}:{generation}:{expected_version + 1}'
+        )
+        return self.store.compare_and_put(
+            key, snapshot, transaction_id=transaction_id,
+            expected_version=expected_version, generation=generation,
+        )
+
+    def load(self, kind, identity, *, minimum_generation=None):
+        value = self.store.get(self._key(kind, identity))
+        if value is None:
+            return None
+        if (minimum_generation is not None and
+                value.generation < int(minimum_generation)):
+            return None
+        return value
+
+    def remove(self, kind, identity, *, generation, transaction_id=None):
+        key = self._key(kind, identity)
+        current = self.store.get(key, include_deleted=True)
+        if current is None:
+            return False
+        self.store.delete(
+            key,
+            transaction_id=(transaction_id or
+                            f'delete:{key}:{generation}:{current.version}'),
+            expected_version=current.version,
+            generation=generation,
+        )
+        return True
+
+    def list(self, kind=None):
+        prefix = 'snapshot/' if kind is None else f'snapshot/{kind}/'
+        return self.store.scan(prefix)
+
+    def snapshot(self):
+        return {
+            'schema': 1,
+            'store': self.store.checkpoint(),
+            'report': self.store.recovery_report(),
+        }
