+class QuorumCheckpoint:
+    """Durable, idempotent quorum decision for a group or chord header."""
+
+    def __init__(self, checkpoint_id, members, quorum=None, *, generation=0,
+                 outcomes=None, decision=CheckpointDecision.PENDING):
+        members = tuple(dict.fromkeys(str(item) for item in members))
+        if not checkpoint_id or not members:
+            raise ValueError('checkpoint_id and at least one member are required')
+        if quorum is None:
+            quorum = len(members)
+        if not isinstance(quorum, int) or not 1 <= quorum <= len(members):
+            raise ValueError('quorum must be between one and member count')
+        self.checkpoint_id = str(checkpoint_id)
+        self.members = members
+        self.quorum = quorum
+        self.generation = int(generation)
+        self._outcomes = {}
+        self._decision = CheckpointDecision(decision)
+        self._sequence = 0
+        self._lock = threading.RLock()
+        for item in outcomes or ():
+            outcome = item if isinstance(item, ChildOutcome) else ChildOutcome(**item)
+            if outcome.child_id not in members:
+                raise ValueError(f'outcome for unknown child {outcome.child_id!r}')
+            self._outcomes[outcome.child_id] = outcome
+            self._sequence = max(self._sequence, outcome.sequence)
+        self._recompute()
+
+    @property
+    def decision(self):
+        with self._lock:
+            return self._decision
+
+    @property
+    def successes(self):
+        with self._lock:
+            return sum(1 for item in self._outcomes.values() if item.success)
+
+    @property
+    def failures(self):
+        with self._lock:
+            return sum(1 for item in self._outcomes.values() if not item.success)
+
+    @property
+    def remaining(self):
+        with self._lock:
+            return len(self.members) - len(self._outcomes)
+
+    def record(self, child_id, success, *, generation=None):
+        child_id = str(child_id)
+        generation = self.generation if generation is None else int(generation)
+        with self._lock:
+            if child_id not in self.members:
+                raise KeyError(child_id)
+            if generation < self.generation:
+                return self._decision, False
+            existing = self._outcomes.get(child_id)
+            if existing is not None:
+                if existing.success != bool(success):
+                    raise ValueError('child terminal outcome cannot change')
+                return self._decision, False
+            self._sequence += 1
+            self._outcomes[child_id] = ChildOutcome(
+                child_id=child_id, success=bool(success),
+                generation=generation, sequence=self._sequence,
+            )
+            previous = self._decision
+            self._recompute()
+            return self._decision, self._decision != previous
+
+    def _recompute(self):
+        successes = sum(1 for item in self._outcomes.values() if item.success)
+        failures = sum(1 for item in self._outcomes.values() if not item.success)
+        remaining = len(self.members) - successes - failures
+        if successes >= self.quorum:
+            self._decision = CheckpointDecision.OPEN
+        elif successes + remaining < self.quorum:
+            self._decision = CheckpointDecision.IMPOSSIBLE
+        else:
+            self._decision = CheckpointDecision.PENDING
+
+    def snapshot(self):
+        with self._lock:
+            return {
+                'schema': 1,
+                'checkpoint_id': self.checkpoint_id,
+                'members': list(self.members),
+                'quorum': self.quorum,
+                'generation': self.generation,
+                'decision': self._decision.value,
+                'outcomes': [
+                    self._outcomes[key].as_dict()
+                    for key in sorted(self._outcomes)
+                ],
+            }
+
+    def encode(self):
+        return canonical_json(self.snapshot()).encode('utf-8')
+
+    @classmethod
+    def restore(cls, payload):
+        if isinstance(payload, bytes):
+            payload = payload.decode('utf-8')
+        data = json.loads(payload) if isinstance(payload, str) else dict(payload)
+        if data.pop('schema', None) != 1:
+            raise EnvelopeValidationError('unsupported checkpoint schema')
+        return cls(**data)
+
+
+class CompletionState(str, Enum):
