+class CompletionTokenStore:
+    """Two-step chord completion token surviving decision/publish crashes."""
+
+    def __init__(self, *, clock=None):
+        self.clock = clock or SystemClock()
+        self._tokens = {}
+        self._lock = threading.RLock()
+
+    def acquire(self, checkpoint, owner, *, generation=None):
+        if not isinstance(checkpoint, QuorumCheckpoint):
+            raise TypeError('checkpoint must be a QuorumCheckpoint')
+        decision = checkpoint.decision
+        if decision == CheckpointDecision.PENDING:
+            raise ValueError('pending checkpoint cannot be completed')
+        generation = checkpoint.generation if generation is None else int(generation)
+        path = 'body' if decision == CheckpointDecision.OPEN else 'errback'
+        with self._lock:
+            current = self._tokens.get(checkpoint.checkpoint_id)
+            if current is not None:
+                if generation < current.generation:
+                    raise LeaseConflict('stale chord completion generation')
+                if generation == current.generation:
+                    if current.path != path:
+                        raise ValueError('checkpoint decision changed after token creation')
+                    return current, False
+            token = CompletionToken(
+                checkpoint_id=checkpoint.checkpoint_id,
+                generation=generation, owner=str(owner), path=path,
+                state=CompletionState.DECIDED,
+                decision_sequence=len(checkpoint._outcomes),
+            )
+            self._tokens[token.checkpoint_id] = token
+            return token, True
+
+    def mark_published(self, checkpoint_id, owner, generation):
+        with self._lock:
+            current = self._tokens.get(str(checkpoint_id))
+            if current is None:
+                raise KeyError(checkpoint_id)
+            if current.owner != owner or current.generation != generation:
+                raise LeaseConflict('stale chord completion owner or generation')
+            if current.state == CompletionState.PUBLISHED:
+                return current, False
+            published = replace(
+                current, state=CompletionState.PUBLISHED,
+                published_at=float(self.clock.wall_time()),
+            )
+            self._tokens[current.checkpoint_id] = published
+            return published, True
+
+    def pending(self):
+        with self._lock:
+            return tuple(
+                self._tokens[key] for key in sorted(self._tokens)
+                if self._tokens[key].state == CompletionState.DECIDED
+            )
+
+    def snapshot(self):
+        with self._lock:
+            return tuple(self._tokens[key].as_dict() for key in sorted(self._tokens))
+
