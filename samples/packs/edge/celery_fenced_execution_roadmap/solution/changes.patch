+@dataclass(frozen=True)
+class ChildOutcome:
+    child_id: str
+    success: bool
+    generation: int
+    sequence: int
+
+    def as_dict(self):
+        return {
+            'child_id': self.child_id,
+            'success': self.success,
+            'generation': self.generation,
